Reason: port: Movement Speed (F9 menu, factor 1/2/4): the real Mario's ground speed target and acceleration in doRunning, its swimming forward speed (doSwimming and the stroke boost in swimPaddleStart), and the forward speed the Hover nozzle adds each frame (TMario::rocketing) are multiplied by port_cheat_movement_speed (platform/misc/port_cheats.cpp); TEnemyMario is left alone through isMario()
--- a/src/Player/MarioRun.cpp
+++ b/src/Player/MarioRun.cpp
@@ -596,1 +596,5 @@
-void TMario::doRunning()
+#ifdef TARGET_PC
+extern "C" int port_cheat_movement_speed;
+#endif
+
+void TMario::doRunning()
@@ -599,1 +603,9 @@
-	f32 sp    = mIntendedMag < maxSp ? mIntendedMag : maxSp;
+	f32 sp    = mIntendedMag < maxSp ? mIntendedMag : maxSp;
+	f32 addBase = MarioRunParam(mRunParams.mAddBase);
+#ifdef TARGET_PC
+	if (isMario()) {
+		const f32 factor = (f32)port_cheat_movement_speed;
+		sp *= factor;
+		addBase *= factor;
+	}
+#endif
@@ -620,1 +632,1 @@
-		mForwardVel += MarioRunParam(mRunParams.mAddBase)
+		mForwardVel += addBase
