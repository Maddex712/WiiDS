--- a/src/Map/PollutionLayer.cpp
+++ b/src/Map/PollutionLayer.cpp
@@ -273,5 +273,5 @@
 				now_pos_no += 1;
-				if (now_pos_no > 10)
+				if (now_pos_no >= 10)
 					now_pos_no = 0;
 			}
 		}
