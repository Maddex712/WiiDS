+#include "SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_SWITCH
+
+// Nintendo Switch homebrew audio output through libnx's audout service. The device is fixed at
+// 48 kHz stereo S16; SDL's audio stream converts whatever the application requests.
+
+#include <malloc.h>
+#include <switch.h>
+
+#include "../SDL_sysaudio.h"
+
+// Four buffers, all kept queued in audout. See SWITCHAUDIO_PlayDevice for why more than one
+// buffer has to be in flight at a time.
+#define SWITCHAUDIO_NUM_BUFFERS 4
+
+struct SDL_PrivateAudioData
+{
+    AudioOutBuffer buffers[SWITCHAUDIO_NUM_BUFFERS];
+    Uint8 *data[SWITCHAUDIO_NUM_BUFFERS];
+    int next_buffer;
+    int queued;  // buffers handed to audout that have not been released back yet
+    bool started;
+};
+
+// Collects finished buffers without blocking.
+static void SWITCHAUDIO_ReapReleased(struct SDL_PrivateAudioData *hidden)
+{
+    AudioOutBuffer *released = NULL;
+    u32 count = 0;
+    while (hidden->queued > 0 && R_SUCCEEDED(audoutGetReleasedAudioOutBuffer(&released, &count)) && count > 0) {
+        hidden->queued -= (int)count;
+        if (hidden->queued < 0) {
+            hidden->queued = 0;
+        }
+        count = 0;
+    }
+}
+
+static bool SWITCHAUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    Result rc = audoutInitialize();
+    if (R_FAILED(rc)) {
+        return SDL_SetError("audoutInitialize failed (rc=0x%x)", rc);
+    }
+    rc = audoutStartAudioOut();
+    if (R_FAILED(rc)) {
+        audoutExit();
+        return SDL_SetError("audoutStartAudioOut failed (rc=0x%x)", rc);
+    }
+
+    device->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) {
+        audoutStopAudioOut();
+        audoutExit();
+        return false;
+    }
+    device->hidden->started = true;
+
+    device->spec.format = SDL_AUDIO_S16LE;
+    device->spec.freq = (int)audoutGetSampleRate();
+    device->spec.channels = (int)audoutGetChannelCount();
+    SDL_UpdatedAudioDeviceFormat(device);
+
+    // audout requires page-aligned sample memory; capacity is rounded up, data_size is exact.
+    const u64 capacity = ((u64)device->buffer_size + 0xFFF) & ~(u64)0xFFF;
+    for (int i = 0; i < SWITCHAUDIO_NUM_BUFFERS; i++) {
+        device->hidden->data[i] = (Uint8 *)memalign(0x1000, capacity);
+        if (!device->hidden->data[i]) {
+            return SDL_SetError("Couldn't allocate audout buffer");
+        }
+        SDL_memset(device->hidden->data[i], device->silence_value, capacity);
+        device->hidden->buffers[i].buffer = device->hidden->data[i];
+        device->hidden->buffers[i].buffer_size = capacity;
+        device->hidden->buffers[i].data_size = (u64)device->buffer_size;
+        device->hidden->buffers[i].data_offset = 0;
+        device->hidden->buffers[i].next = NULL;
+    }
+    return true;
+}
+
+static Uint8 *SWITCHAUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    return device->hidden->data[device->hidden->next_buffer];
+}
+
+static bool SWITCHAUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    struct SDL_PrivateAudioData *hidden = device->hidden;
+    AudioOutBuffer *source = &hidden->buffers[hidden->next_buffer];
+    source->data_size = (u64)buflen;
+    // audoutPlayBuffer() appends *and waits for that buffer to finish playing*, so it can never
+    // keep more than one buffer in flight: audout ran dry for the whole time SDL spent mixing the
+    // next chunk, and the gap between every pair of buffers was audible as a constant stutter,
+    // at any frame rate. Append without blocking instead and let SWITCHAUDIO_WaitDevice do the
+    // pacing, so the hardware always has the next buffer ready before the current one ends.
+    const Result rc = audoutAppendAudioOutBuffer(source);
+    if (R_FAILED(rc)) {
+        return false;
+    }
+    hidden->queued++;
+    hidden->next_buffer = (hidden->next_buffer + 1) % SWITCHAUDIO_NUM_BUFFERS;
+    return true;
+}
+
+static bool SWITCHAUDIO_WaitDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *hidden = device->hidden;
+    SWITCHAUDIO_ReapReleased(hidden);
+    // Only block when every buffer is still with audout - that is the one point where waiting
+    // cannot starve the device, because it already holds SWITCHAUDIO_NUM_BUFFERS of audio.
+    while (hidden->queued >= SWITCHAUDIO_NUM_BUFFERS) {
+        AudioOutBuffer *released = NULL;
+        u32 count = 0;
+        if (R_FAILED(audoutWaitPlayFinish(&released, &count, UINT64_MAX))) {
+            return false;
+        }
+        hidden->queued -= (int)count;
+        if (hidden->queued < 0) {
+            hidden->queued = 0;
+        }
+        SWITCHAUDIO_ReapReleased(hidden);
+    }
+    return true;
+}
+
+static void SWITCHAUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    if (!device->hidden) {
+        return;
+    }
+    if (device->hidden->started) {
+        audoutStopAudioOut();
+        audoutExit();
+        device->hidden->queued = 0;
+    }
+    for (int i = 0; i < SWITCHAUDIO_NUM_BUFFERS; i++) {
+        free(device->hidden->data[i]);
+    }
+    SDL_free(device->hidden);
+    device->hidden = NULL;
+}
+
+static bool SWITCHAUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->OpenDevice = SWITCHAUDIO_OpenDevice;
+    impl->PlayDevice = SWITCHAUDIO_PlayDevice;
+    impl->WaitDevice = SWITCHAUDIO_WaitDevice;
+    impl->GetDeviceBuf = SWITCHAUDIO_GetDeviceBuf;
+    impl->CloseDevice = SWITCHAUDIO_CloseDevice;
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    return true;
+}
+
+AudioBootStrap SWITCHAUDIO_bootstrap = {
+    "switch", "Nintendo Switch audout", SWITCHAUDIO_Init, false, false
+};
+
+#endif // SDL_AUDIO_DRIVER_SWITCH
