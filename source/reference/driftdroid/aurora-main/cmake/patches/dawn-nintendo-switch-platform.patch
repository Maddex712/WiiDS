+#define COMBINED_SAMPLER_ELEMENT_MEMBERS(X) \
+    X(BindGroupIndex, group)                \
+    X(BindingIndex, index)                  \
+    X(BindingIndex, shaderArraySize, 1u)
+DAWN_SERIALIZABLE(struct, CombinedSamplerElement, COMBINED_SAMPLER_ELEMENT_MEMBERS){};
