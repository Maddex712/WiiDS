+
+#include <vector>
+
+#include "src/dawn/native/RenderPipeline.h"
+#include "src/dawn/native/deko3d/PipelineDeko3d.h"
+
+namespace dawn::native::deko3d {
+
+class Device;
+
+class RenderPipeline final : public RenderPipelineBase, public PipelineDeko3d {
+  public:
+    static Ref<RenderPipeline> CreateUninitialized(
+        Device* device,
+        const UnpackedPtr<RenderPipelineDescriptor>& descriptor);
+
+    DkPrimitive GetDkPrimitive() const { return mPrimitive; }
+
+    // Binds shaders and all fixed-function state; stencil reference is dynamic render pass state.
+    void ApplyNow(DkCmdBuf cmdBuf, uint32_t stencilReference);
+
+    MaybeError InitializeImpl() override;
+
+  private:
+    RenderPipeline(Device* device, const UnpackedPtr<RenderPipelineDescriptor>& descriptor);
+    ~RenderPipeline() override;
+
+    DkPrimitive mPrimitive = DkPrimitive_Triangles;
+    DkRasterizerState mRasterizerState;
+    DkMultisampleState mMultisampleState;
+    DkColorState mColorState;
+    DkColorWriteState mColorWriteState;
