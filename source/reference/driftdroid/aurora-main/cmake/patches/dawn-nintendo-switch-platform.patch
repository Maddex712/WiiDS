+#ifndef SRC_DAWN_NATIVE_DEKO3D_INTEGERTYPES_H_
+#define SRC_DAWN_NATIVE_DEKO3D_INTEGERTYPES_H_
+
+#include <cstdint>
+#include "src/utils/typed_integer.h"
+
+namespace dawn::native::deko3d {
+
+// An index used to represent the position of bindings in the flattened deko3d binding space. Prevents
+// confusion with BindingIndex which is an index in the bindings of a single BGL.
+using FlatBindingIndex = TypedInteger<struct FlatBindingIndexT, uint32_t>;
+
+// An index of the texture unit, which shouldn't be confused with other kinds of indices.
+using TextureUnit = TypedInteger<struct TextureUnitT, uint32_t>;
