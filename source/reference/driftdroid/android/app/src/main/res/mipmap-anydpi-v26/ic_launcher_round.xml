<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher applies its own mask (circle, squircle, teardrop), so the icon is
     never a bare square. minSdk is 29, so every supported device uses this; the ic_launcher PNGs
     are only a fallback. The artwork sits inside the 72dp safe zone of the 108dp canvas, on a
     background matching its own, so no mask shape crops it. WiiDS ships no game artwork. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
