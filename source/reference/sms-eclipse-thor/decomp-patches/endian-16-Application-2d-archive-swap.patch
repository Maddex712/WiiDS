+#ifdef TARGET_PC
+	// The 2D archives (game_6 and guide) take turns in one buffer, and the
+	// screens built from either keep pointers into it. The ARAM copy just
+	// put big-endian bytes back, so convert every file again (conversion is
+	// idempotent) instead of waiting for fetches that will not come.
+	for (u32 i = 0; i < param_1->countFile(); i++)
+		if (param_1->getFileAttribute(i) & 1)
+			param_1->getIdxResource(i);
+#endif
