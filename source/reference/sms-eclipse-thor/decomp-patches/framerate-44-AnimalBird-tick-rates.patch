 // TODO: 95.4%. Instruction-identical except the quaternion temporary's
 // register numbering inside the inlined rotate and toGoal 4 bytes low.
+#ifdef TARGET_PC
+// Port: a bird's flight, take-off and landing steps run on every 1/120 s
+// movement tick (four a frame at 30 fps, two at 60, one at 120) and scale
+// their speeds and turns by SMSGetAnmFrameRate(), a per-frame rate that
+// halves at 60 fps and quarters at 120 while the tick rate does not, so the
+// birds flew and turned at half speed at 60 and a quarter at 120. Use the
+// 30 fps value.
+#include "port_framerate.h"
+static inline f32 BirdPortTickAnmRate()
+{
+	return port_native_frame_divisor() * SMSGetAnmFrameRate();
+}
+#define BIRD_TICK_ANM_RATE() BirdPortTickAnmRate()
+#else
+#define BIRD_TICK_ANM_RATE() SMSGetAnmFrameRate()
+#endif
