Reason: port: the *4LiveActor script commands touch TLiveActor fields only on real TLiveActors; Super Mario Eclipse's Red Lily City switch script calls setDead4LiveActor on map statics (TMapStaticObj), and retail's out-of-bounds mLiveFlag write lands natively in the next map static's MActor pointer, which crashed episode 2
--- a/src/System/EventWatcher.cpp
+++ b/src/System/EventWatcher.cpp
@@ -389,6 +389,30 @@
 // TODO: removeme
 extern const TNerveBase<TLiveActor>* NerveGetByIndex(int param_1);
 
+#ifdef TARGET_PC
+// The *4LiveActor commands trust the script to name a TLiveActor. Super Mario
+// Eclipse's Red Lily City switch script also names map statics (TMapStaticObj,
+// a THitActor but no TLiveActor), so retail touches mLiveFlag (0xF0) past the
+// 0x80-byte object, in the next heap block. Natively that write lands in the
+// next map static's MActor pointer, and drawing it crashes. Treat only real
+// TLiveActors as live actors.
+static TLiveActor* EventWatcherLiveActor(JDrama::TNameRef* ref)
+{
+	return dynamic_cast<TLiveActor*>(ref);
+}
+
+// A THitActor that is no TLiveActor keeps retail's collision change.
+static void EventWatcherSetNoCollision(JDrama::TNameRef* ref, s32 value)
+{
+	if (THitActor* hitActor = dynamic_cast<THitActor*>(ref)) {
+		if (value)
+			hitActor->onHitFlag(HIT_FLAG_NO_COLLISION);
+		else
+			hitActor->offHitFlag(HIT_FLAG_NO_COLLISION);
+	}
+}
+#endif
