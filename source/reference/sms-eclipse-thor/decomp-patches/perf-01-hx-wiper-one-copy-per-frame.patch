Reason: port: Hx_Test5 (the map's wipe, among others) makes about 80 64x64 EFB copies a frame, and each one is a render-pass switch and a write-back on the PC, which dropped the frame rate during the wipe; it copies all its cells at once and draws each fan from its cell of that copy, the same picture
--- a/src/GC2D/hx_wiper.c
+++ b/src/GC2D/hx_wiper.c
@@ -2121,6 +2121,23 @@
 // are single-use, so copy propagation removes them but each keeps the 4-byte
 // slot retail has above obj. mag_out/mag_in declared first put their spill
 // slots above the first-vertex block, as in retail.
+#ifdef TARGET_PC
+/* port: Hx_Test5 copies the frame in 64x64 cells, drawing each cell's fan
+ * before copying the next, about 80 EFB copies a frame into one buffer. Each
+ * fan stays inside its own cell, which the copy has cleared, so one copy of all
+ * the cells draws the same picture; the fans then take their cell of it. On the
+ * PC every EFB copy is a render-pass switch and a write-back, which made the
+ * map's wipe drop the frame rate. */
+static u8 hx_pc_cell_buffer[640 * 528 * 2] __attribute__((aligned(32)));
+static int hx_pc_cells;
+static f32 hx_pc_cell_w, hx_pc_cell_h, hx_pc_cell_u, hx_pc_cell_v;
+#define HX_PC_CELL_TEXCOORD(u, v)                                              \
+	GXTexCoord2f32(hx_pc_cells ? hx_pc_cell_u + (u) * (64.0f / hx_pc_cell_w) : (u), \
+	               hx_pc_cells ? hx_pc_cell_v + (v) * (64.0f / hx_pc_cell_h) : (v))
+#else
+#define HX_PC_CELL_TEXCOORD(u, v) GXTexCoord2f32(u, v)
+#endif
+
 static void Hx_Test5(void)
 {
 	u32 timer;
