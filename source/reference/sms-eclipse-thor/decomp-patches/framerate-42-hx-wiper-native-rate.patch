+#ifdef TARGET_PC
+#include <string.h>
+/* port: the game draws and advances a wipe in one call a frame, counted in
+ * frames: at frame_rate 60 or 120 every wipe ran two or four times as fast
+ * (a warp's closing wipe ended before its pipe sound, which the next stage
+ * then cut short). Hx_UpdateWipe advances a wipe on one frame in each native
+ * 30 Hz one; on the others it still draws it, from state it saves and then
+ * puts back: hx, the file's other state, and each handler's own statics,
+ * which the handler registers (HX_PC_KEEP) the first time it runs, always on
+ * an advancing frame. */
+extern int port_active_frame_rate;
+static struct {
+	void* p;
+	u32 n;
+} hx_pc_keep_list[48];
+static int hx_pc_keep_count;
+static int hxs_logo_resetflag;
+static int hxs_logodraw_resetflag;
+static u32 hx_pc_frame;
+static void hx_pc_keep(void* p, u32 n)
+{
+	int i;
+	for (i = 0; i < hx_pc_keep_count; i++)
+		if (hx_pc_keep_list[i].p == p)
+			return;
+	if (hx_pc_keep_count < (int)(sizeof(hx_pc_keep_list) / sizeof(hx_pc_keep_list[0]))) {
+		hx_pc_keep_list[hx_pc_keep_count].p = p;
+		hx_pc_keep_list[hx_pc_keep_count].n = n;
+		hx_pc_keep_count++;
+	}
+}
+#define HX_PC_KEEP(v) hx_pc_keep(&(v), sizeof(v))
+#endif
