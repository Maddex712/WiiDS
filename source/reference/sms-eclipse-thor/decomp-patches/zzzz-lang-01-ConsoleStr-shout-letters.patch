+// Port: the panes 'xx00', 'xx01', ... of one of the shouts, as many as the
+// layout has (English: GO! 3, SHINE! 6, TOO BAD! 7; a language pack's up to
+// TConsoleStr::cMaxLetters).
+static int ConsoleStrLetters(J2DScreen* screen, char a, char b, TBoundPane** panes)
+{
+	int n = 0;
+	while (n < TConsoleStr::cMaxLetters) {
+		u32 tag = (u32)a << 24 | (u32)b << 16 | (u32)('0' + n / 10) << 8 | (u32)('0' + n % 10);
+		if (!screen->search(tag))
+			break;
+		panes[n++] = new TBoundPane(screen, tag);
+	}
+	return n;
+}
+
+// Port: where GO!'s letter `i` of `n` flies once it has landed: English's
+// three go up-left, up and up-right; longer words spread over the same arc.
+static void ConsoleStrGoFlight(int i, int n, JUTPoint& mid, JUTPoint& end)
+{
+	f32 t  = n > 1 ? (f32)i / (n - 1) : 0.5f;
+	f32 x  = t < 0.5f ? -170.0f * (1.0f - 2.0f * t) : 160.0f * (2.0f * t - 1.0f);
+	f32 up = 1.0f - (t < 0.5f ? 1.0f - 2.0f * t : 2.0f * t - 1.0f);
+	int mx = (int)x, my = (int)(-180.0f - 40.0f * up);
+	mid.set(mx, my);
+	end.set(mx * 2, my * 2);
+}
