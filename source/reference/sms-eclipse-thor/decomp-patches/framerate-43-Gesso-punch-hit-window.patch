+		if (GessoPunchPasses(mMActor->getFrameCtrl(ANM_TYPE_BCK), 10.0f))
+#else
 		if (mMActor->getFrameCtrl(ANM_TYPE_BCK)->checkPass(10.0f))
+#endif
 			SMS_SendMessageToMario(this, HIT_MESSAGE_ATTACK);
 
 		return;
