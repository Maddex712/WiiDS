Reason: port: with frame_rate = 60 or 120 a Blooper's punch only hurt Mario when the punch animation passed frame 10 on a hit-check tick, which comes once in two or four displayed frames while the animation steps one or a half frame each; test the animation's whole step between two hit checks, as at 30 fps
--- a/src/Enemy/gesso.cpp
+++ b/src/Enemy/gesso.cpp
@@ -30,6 +30,26 @@
 #include <MSound/MSoundBGM.hpp>
 #include <M3DUtil/InfectiousStrings.hpp>
 
+#ifdef TARGET_PC
+// Port: a Blooper's punch hurts Mario if the punch animation passes frame 10
+// in its next step (checkPass) on a tick with a hit check. Hit checks run on
+// one movement tick in four, which is once a frame at 30 fps, so the check
+// sees each two-frame animation step once. At 60 and 120 fps the animation
+// steps one or a half frame per displayed frame and the hit check comes every
+// other or every fourth frame, so it saw only one or two of the steps between
+// checks and the punch never landed when frame 10 fell in another. Test the
+// whole native step: the animation's advance between two hit checks.
+#include "port_framerate.h"
+static inline bool GessoPunchPasses(J3DFrameCtrl* ctrl, f32 frame)
+{
+	f32 rate = ctrl->getRate();
+	ctrl->setRate(rate * port_native_frame_divisor());
+	bool pass = ctrl->checkPass(frame);
+	ctrl->setRate(rate);
+	return pass;
+}
+#endif
+
 TGesso* gpCurGesso;
 
 const char* rikuGesso_bastable[] = {
@@ -463,7 +483,11 @@
 	}
 
 	if (mSpine->getCurrentNerve() == &TNerveGessoPunch::theNerve()) {
