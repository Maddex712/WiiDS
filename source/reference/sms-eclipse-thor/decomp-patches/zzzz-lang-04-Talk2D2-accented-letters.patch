+#ifdef TARGET_PC
+// Port: whether a text byte starts a two-byte character, as the font
+// says. The game took every byte from 0x80 up as the first of a Shift-JIS
+// pair, which the North American text never has; the European languages'
+// accented letters are single bytes there (á is 0xE1), and were drawn
+// together with the letter after them. The system font is single-byte.
+static inline bool Talk2D2LeadByte(char c) { return gpSystemFont->isLeadByte((u8)c); }
+#else
+static inline bool Talk2D2LeadByte(char c) { return (u8)c >= 0x80; }
+#endif
