+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_dev_wiids_colosseum_ColosseumGameActivity_clearButtons(JNIEnv*, jclass) {
+  g_androidButtons.store(0, std::memory_order_relaxed);
+  g_touchButtons.store(0, std::memory_order_relaxed);
+  g_fastForward.store(false, std::memory_order_relaxed);
+}
