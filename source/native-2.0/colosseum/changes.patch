+    g_fastForward.store(pressed, std::memory_order_relaxed);
+    return JNI_TRUE;
+  }
+  return android_button(g_androidButtons, key, pressed);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_dev_wiids_colosseum_ColosseumGameActivity_touchButton(JNIEnv*, jclass, jint key, jboolean pressed) {
+  android_button(g_touchButtons, key, pressed);
+}
