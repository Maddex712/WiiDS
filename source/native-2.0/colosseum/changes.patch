-  return g_pad ? read_gamepad() : read_keyboard();
+  PadInput pad = g_pad ? read_gamepad() : read_keyboard();
+#if defined(__ANDROID__)
+  const uint16_t touch = g_touchButtons.load(std::memory_order_relaxed);
+  constexpr uint16_t directions = kLeft | kRight | kUp | kDown;
+  const uint16_t buttons = g_androidButtons.load(std::memory_order_relaxed) |
+                          (g_touchStick ? uint16_t(touch & ~directions) : touch);
+  // The field uses the main stick. Menus get a D-pad press only.
+  if (g_touchStick && (touch & (kLeft | kRight)))
+    pad.stick_x = uint8_t(128 + 80 * (int(bool(touch & kRight)) - int(bool(touch & kLeft))));
+  if (g_touchStick && (touch & (kUp | kDown)))
+    pad.stick_y = uint8_t(128 + 80 * (int(bool(touch & kUp)) - int(bool(touch & kDown))));
+  pad.buttons |= buttons;
+  if (buttons & kL) pad.trigger_l = 255;
+  if (buttons & kR) pad.trigger_r = 255;
+#endif
+  return pad;
 }
 
+#if defined(__ANDROID__)
+static bool android_button(std::atomic<uint16_t>& buttons, jint key, bool pressed) {
+  uint16_t button;
+  switch (key) {
+  case AKEYCODE_BUTTON_A: case AKEYCODE_X: button = kA; break;
+  case AKEYCODE_BUTTON_B: case AKEYCODE_Z: button = kB; break;
+  case AKEYCODE_BUTTON_X: case AKEYCODE_C: button = kX; break;
+  case AKEYCODE_BUTTON_Y: case AKEYCODE_S: button = kY; break;
+  case AKEYCODE_BUTTON_START: case AKEYCODE_ENTER: button = kStart; break;
+  case AKEYCODE_BUTTON_L1: case AKEYCODE_BUTTON_L2: button = kL; break;
+  case AKEYCODE_BUTTON_R1: button = kZ; break;
+  case AKEYCODE_BUTTON_R2: button = kR; break;
+  case AKEYCODE_DPAD_UP: button = kUp; break;
+  case AKEYCODE_DPAD_DOWN: button = kDown; break;
+  case AKEYCODE_DPAD_LEFT: button = kLeft; break;
+  case AKEYCODE_DPAD_RIGHT: button = kRight; break;
+  default: return JNI_FALSE;
+  }
+  if (pressed)
+    buttons.fetch_or(button, std::memory_order_relaxed);
+  else
+    buttons.fetch_and(uint16_t(~button), std::memory_order_relaxed);
+  return true;
+}
