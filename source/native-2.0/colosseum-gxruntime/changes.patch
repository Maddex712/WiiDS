+// WiiDS: the mean luminance of the game image (0..255), for a companion screen that follows the
+// picture going black. Nine rows of every sixth frame are copied to a small buffer at the end of
+// the frame's own command buffer and mapped asynchronously; nothing waits for the result. Off
+// until aurora_luma_probe_enable(true).
+std::atomic<bool> g_lumaEnabled{false};
+std::atomic<int> g_lumaLevel{-1};
+std::atomic<bool> g_lumaBusy{false};
+struct LumaJob {
+  wgpu::Buffer buffer;
+  uint32_t width = 0, pitch = 0;
+  bool bgra = false, encoded = false;
+  uint32_t tick = 0;
+};
+LumaJob g_luma;  // the thread ending frames, and the map callback while g_lumaBusy
+constexpr uint32_t kLumaRows = 9;
+
+void luma_encode(const wgpu::CommandEncoder& encoder) {
+  if (!g_lumaEnabled.load(std::memory_order_relaxed) || g_lumaBusy.load(std::memory_order_acquire) ||
+      ++g_luma.tick % 6 != 0) {
+    return;
+  }
+  const auto& src = webgpu::present_source();
+  const bool bgra = src.format == wgpu::TextureFormat::BGRA8Unorm || src.format == wgpu::TextureFormat::BGRA8UnormSrgb;
+  const bool rgba = src.format == wgpu::TextureFormat::RGBA8Unorm || src.format == wgpu::TextureFormat::RGBA8UnormSrgb;
+  if (!src.texture || src.size.width == 0 || src.size.height < kLumaRows || (!bgra && !rgba)) {
+    return;
+  }
+  const uint32_t pitch = AURORA_ALIGN(src.size.width * 4, 256);
+  if (!g_luma.buffer || g_luma.pitch != pitch) {
+    const wgpu::BufferDescriptor descriptor{.label = "Luminance probe readback",
+                                            .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+                                            .size = uint64_t(pitch) * kLumaRows};
+    g_luma.buffer = g_device.CreateBuffer(&descriptor);
+    g_luma.pitch = pitch;
+    if (!g_luma.buffer) {
+      return;
+    }
+  }
+  g_luma.width = src.size.width;
+  g_luma.bgra = bgra;
+  for (uint32_t r = 0; r < kLumaRows; ++r) {
+    const wgpu::TexelCopyTextureInfo from{.texture = src.texture,
+                                          .origin = {0, (2 * r + 1) * src.size.height / (2 * kLumaRows), 0}};
+    const wgpu::TexelCopyBufferInfo to{.layout = {.offset = uint64_t(pitch) * r, .bytesPerRow = pitch, .rowsPerImage = 1},
+                                       .buffer = g_luma.buffer};
+    const wgpu::Extent3D extent{g_luma.width, 1, 1};
+    encoder.CopyTextureToBuffer(&from, &to, &extent);
+  }
+  g_luma.encoded = true;
+}
+
+void luma_after_submit() {
+  if (!g_luma.encoded) {
+    return;
+  }
+  g_luma.encoded = false;
+  g_lumaBusy.store(true, std::memory_order_release);
+  g_luma.buffer.MapAsync(wgpu::MapMode::Read, 0, g_luma.buffer.GetSize(), wgpu::CallbackMode::AllowSpontaneous,
+                         [](wgpu::MapAsyncStatus status, wgpu::StringView) {
+    if (status == wgpu::MapAsyncStatus::Success) {
+      const auto* px = static_cast<const uint8_t*>(g_luma.buffer.GetConstMappedRange(0, g_luma.buffer.GetSize()));
+      if (px != nullptr) {
+        uint64_t sum = 0;
+        const int ri = g_luma.bgra ? 2 : 0, bi = g_luma.bgra ? 0 : 2;
+        for (uint32_t r = 0; r < kLumaRows; ++r) {
