+void aurora_luma_probe_enable(bool enabled) {
+#ifdef AURORA_ENABLE_GX
+  aurora::g_lumaEnabled.store(enabled, std::memory_order_relaxed);
+#endif
+}
+int aurora_luma_probe_level(void) {
+#ifdef AURORA_ENABLE_GX
+  return aurora::g_lumaLevel.load(std::memory_order_relaxed);
+#else
+  return -1;
+#endif
+}
