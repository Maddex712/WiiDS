+// WiiDS: the average luminance of the game image (0..255), for a companion screen that follows
+// the picture going black. Nine rows of every sixth frame are copied to a small buffer and mapped
+// asynchronously (no wait anywhere); off until aurora_luma_probe_enable(true).
+std::atomic<bool> g_lumaEnabled{false};
+std::atomic<int> g_lumaLevel{-1};
+std::atomic<bool> g_lumaBusy{false};
+struct LumaJob {
+  wgpu::Buffer buffer;
+  uint32_t width = 0, pitch = 0;
+  bool bgra = false, encoded = false;
+  uint32_t tick = 0;
+};
+LumaJob g_luma; // render worker (and the map callback while busy)
+constexpr uint32_t kLumaRows = 9;
+
+void luma_encode(const wgpu::CommandEncoder& encoder) {
+  static const bool sLateSubmit = std::getenv("AURORA_LATE_SUBMIT") != nullptr;
+  if (sLateSubmit || !g_lumaEnabled.load(std::memory_order_relaxed) || g_lumaBusy.load(std::memory_order_acquire) ||
+      ++g_luma.tick % 6 != 0) {
+    return;
+  }
+  const auto& src = webgpu::present_source();
+  if (!src.texture || src.size.width == 0 || src.size.height < kLumaRows ||
+      (src.format != wgpu::TextureFormat::BGRA8Unorm && src.format != wgpu::TextureFormat::RGBA8Unorm)) {
+    return;
+  }
+  const uint32_t pitch = AURORA_ALIGN(src.size.width * 4, 256);
+  if (!g_luma.buffer || g_luma.pitch != pitch) {
+    const wgpu::BufferDescriptor bd{.label = "Luminance probe readback",
+                                    .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+                                    .size = uint64_t(pitch) * kLumaRows};
+    g_luma.buffer = g_device.CreateBuffer(&bd);
+    g_luma.pitch = pitch;
+  }
+  g_luma.width = src.size.width;
+  g_luma.bgra = src.format == wgpu::TextureFormat::BGRA8Unorm;
+  for (uint32_t r = 0; r < kLumaRows; ++r) {
+    const wgpu::TexelCopyTextureInfo s{.texture = src.texture,
+                                       .origin = {0, (2 * r + 1) * src.size.height / (2 * kLumaRows), 0}};
+    const wgpu::TexelCopyBufferInfo d{.layout = {.offset = uint64_t(pitch) * r, .bytesPerRow = pitch, .rowsPerImage = 1},
+                                      .buffer = g_luma.buffer};
+    const wgpu::Extent3D extent{g_luma.width, 1, 1};
+    encoder.CopyTextureToBuffer(&s, &d, &extent);
+  }
+  g_luma.encoded = true;
+}
+
+void luma_after_submit() {
+  if (!g_luma.encoded) {
+    return;
+  }
+  g_luma.encoded = false;
+  g_lumaBusy.store(true, std::memory_order_release);
+  g_luma.buffer.MapAsync(wgpu::MapMode::Read, 0, g_luma.buffer.GetSize(), wgpu::CallbackMode::AllowSpontaneous,
+                         [](wgpu::MapAsyncStatus status, wgpu::StringView) {
+    if (status == wgpu::MapAsyncStatus::Success) {
+      const auto* px = static_cast<const uint8_t*>(g_luma.buffer.GetConstMappedRange(0, g_luma.buffer.GetSize()));
+      if (px != nullptr) {
+        uint64_t sum = 0;
+        const int ri = g_luma.bgra ? 2 : 0, bi = g_luma.bgra ? 0 : 2;
+        for (uint32_t r = 0; r < kLumaRows; ++r) {
+          const uint8_t* row = px + size_t(r) * g_luma.pitch;
+          for (uint32_t x = 0; x < g_luma.width; ++x) {
+            sum += 54u * row[x * 4 + ri] + 183u * row[x * 4 + 1] + 19u * row[x * 4 + bi];
+          }
+        }
+        const int now = static_cast<int>(sum / (uint64_t(256) * kLumaRows * g_luma.width));
+        const int old = g_lumaLevel.load(std::memory_order_relaxed);
+        g_lumaLevel.store(old < 0 ? now : (old + now + 1) / 2, std::memory_order_relaxed); // lightly smoothed
+      }
+      g_luma.buffer.Unmap();
+    }
+    g_lumaBusy.store(false, std::memory_order_release);
+  });
+}
