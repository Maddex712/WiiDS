+// bloodframe: the Vulkan query above can accept STORAGE for AHB images that gralloc then refuses to
+// allocate: before gralloc 4.1 a non-BLOB format with GPU_DATA_BUFFER usage fails (AYN Thor,
+// Adreno 740). Allocate a small buffer with the usage ahb_usage() would ask the host for.
+bool ahbAllocatorAcceptsStorage(VkFormat format) {
+#ifdef __ANDROID__
+    AHardwareBuffer_Desc desc{
+        .width = 64,
+        .height = 64,
+        .layers = 1,
+        .format = format == VK_FORMAT_R16G16B16A16_SFLOAT
+            ? AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT
+            : AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM,
+        .usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT
+            | AHARDWAREBUFFER_USAGE_GPU_DATA_BUFFER,
+    };
+    AHardwareBuffer* buffer = nullptr;
+    if (AHardwareBuffer_allocate(&desc, &buffer) != 0 || buffer == nullptr)
+        return false;
+    AHardwareBuffer_release(buffer);
+    return true;
+#else
+    (void)format;
+    return true;
+#endif
+}
