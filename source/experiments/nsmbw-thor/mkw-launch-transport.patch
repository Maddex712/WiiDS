@@ -0,0 +1,37 @@
+package com.driftdroid.android
+
+import android.app.Activity
+import android.content.ActivityNotFoundException
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+
+/** Launch transport for the shared Wii library. The library's artwork and layout own the UI. */
+internal object ThorGameLaunch {
+    const val NSMB_WII = "nsmbw"
+    const val NSMB_PACKAGE = "com.wither.nsmbw.thor"
+    private const val ACTION_PLAY = "dev.thor.launcher.action.PLAY_GAME"
+    private val nsmbEntry = ComponentName(NSMB_PACKAGE, "com.wither.nsmbw.ThorLaunchActivity")
+
+    enum class Result { OPENED, NOT_INSTALLED, UNAVAILABLE }
+
+    /** Installed means the entry point exists; game-data readiness belongs to the NSMB runtime. */
+    fun nsmbInstalled(context: Context): Boolean =
+        context.packageManager.resolveActivity(Intent(ACTION_PLAY).setComponent(nsmbEntry), 0)
+            ?.activityInfo?.let { it.enabled && it.exported } == true
+
+    fun launchNsmb(activity: Activity): Result {
+        if (!nsmbInstalled(activity)) return Result.NOT_INSTALLED
+        return try {
+            activity.startActivity(Intent(ACTION_PLAY).setComponent(nsmbEntry)
+                .putExtra("thor_protocol", 1)
+                .putExtra("thor_game", NSMB_WII)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP or Intent.FLAG_ACTIVITY_SINGLE_TOP))
+            Result.OPENED
+        } catch (_: ActivityNotFoundException) {
+            Result.NOT_INSTALLED
+        } catch (_: SecurityException) {
+            Result.UNAVAILABLE
+        }
+    }
+}
