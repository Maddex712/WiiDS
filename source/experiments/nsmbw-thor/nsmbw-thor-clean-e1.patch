+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.util.Log;
+import android.view.Display;
+import android.view.View;
+import android.view.Window;
+import android.view.WindowManager;
+import java.io.File;
+
+/** Handheld-style course progress, Star Coins, world overview and physical reserve action. */
+final class ThorLowerScreen implements DisplayManager.DisplayListener {
+    private static final String TAG = "NSMBW-ThorHUD";
+    private final Activity activity;
+    private final DisplayManager displays;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private HudPresentation presentation;
+    private ThorHudAssets assets;
+    private ThorGameState state;
+    private ThorWorldMap worldMap;
+    private ThorReserveState reserve;
+    private boolean running, closed;
+    private long lastSequence = -1, lastAdvance, lastLog;
+    private String lastIdentity = "";
+
+    ThorLowerScreen(Activity activity) {
+        this.activity = activity;
+        displays = activity.getSystemService(DisplayManager.class);
+        final File folder = new File(AppFiles.dataDir(activity), "ThorHud");
+        new Thread(() -> {
+            ThorHudAssets loaded = null;
+            try { loaded = new ThorHudAssets(folder); }
+            catch (Exception failure) { Log.w(TAG, "Original lower HUD assets unavailable", failure); }
+            final ThorHudAssets result = loaded;
+            handler.post(() -> {
+                if (closed) { if (result != null) result.close(); return; }
+                assets = result;
+                if (presentation != null) presentation.view.invalidate();
+                Log.i(TAG, "Original lower HUD assets " + (result == null ? "unavailable" : "verified"));
+            });
+        }, "ThorHudAssets").start();
+    }
+
+    void start() {
+        if (running || closed || displays == null) return;
+        running = true;
+        state = null; worldMap = null; reserve = null; lastSequence = -1; lastAdvance = SystemClock.uptimeMillis();
+        displays.registerDisplayListener(this, handler);
+        refresh(); handler.post(poll);
+    }
+
+    void stop() {
+        if (!running) return;
+        running = false;
+        displays.unregisterDisplayListener(this);
+        handler.removeCallbacks(poll);
+        state = null;
+        worldMap = null; reserve = null;
+        dismiss();
+        Log.i(TAG, "Lower screen released");
+    }
+
+    void close() {
+        stop(); closed = true;
+        if (assets != null) { assets.close(); assets = null; }
+    }
+
+    private final Runnable poll = new Runnable() {
+        @Override public void run() {
+            if (!running || closed) return;
+            long now = SystemClock.uptimeMillis();
+            ThorGameState next = null;
+            try { next = ThorGameState.read(); }
+            catch (UnsatisfiedLinkError unavailable) { Log.e(TAG, "Snapshot bridge unavailable", unavailable); stop(); return; }
+            if (next != null && next.sequence != lastSequence) {
+                lastSequence = next.sequence; lastAdvance = now;
+                state = next;
+            } else if (now - lastAdvance > 1500) state = null;
+            worldMap = state != null && state.scene == 3 ? ThorWorldMap.read() : null;
+            reserve = ThorReserveState.read();
+            if (presentation != null) { presentation.view.acceptMotion(); presentation.view.invalidate(); }
+            if (state != null) {
+                String identity = state.scene + ":" + state.mode + ":" + state.world + ":" + state.stage + ":" + state.fields
+                        + ":" + state.starCoins + ":" + state.savedStarCoins
+                        + ":" + (worldMap == null ? 0 : worldMap.points.length)
+                        + ":" + (reserve == null ? -1 : reserve.item)
+                        + ":" + (reserve == null ? 0 : reserve.uses) + ":" + (reserve == null ? 0 : reserve.stores);
+                if (!identity.equals(lastIdentity) || (state.has(ThorGameState.COURSE) && now - lastLog > 5000)) {
+                    Log.i(TAG, "state seq=" + state.sequence + " fields=" + state.fields + " scene=" + state.scene
+                            + " mode=" + state.mode + " world=" + state.world + " course=" + state.stage
+                            + " character=" + state.character + " lives=" + state.lives + " p1Coins=" + state.coins
+                            + " seconds=" + state.seconds + " progress=" + state.progress
+                            + " stars=" + state.starCoins + "/" + state.savedStarCoins + " score=" + state.score
+                            + " area=" + state.area + " nodes=" + (worldMap == null ? 0 : worldMap.points.length)
+                            + " reserve=" + (reserve == null ? -1 : reserve.item)
+                            + " reserveSeq=" + (reserve == null ? -1 : reserve.sequence)
+                            + " reserveSlot=" + (reserve == null ? -1 : reserve.context)
+                            + " reserveReady=" + (reserve != null && reserve.canUse)
+                            + " uses=" + (reserve == null ? 0 : reserve.uses)
+                            + " stores=" + (reserve == null ? 0 : reserve.stores));
+                    lastIdentity = identity; lastLog = now;
+                }
+            }
+            handler.postDelayed(this, 50);
+        }
+    };
+
+    private void dismiss() {
+        HudPresentation old = presentation;
+        presentation = null;
+        if (old != null) old.dismiss();
+    }
+
+    private void refresh() {
+        if (!running || closed) return;
+        int upper = activity.getWindowManager().getDefaultDisplay().getDisplayId();
+        Display target = null;
+        for (Display display : displays.getDisplays(DisplayManager.DISPLAY_CATEGORY_PRESENTATION)) {
+            // Thor's internal panel only: never put a HUD on a cast/virtual/HDMI display.
+            if (display.isValid() && display.getDisplayId() != upper && "Screen-2".equals(display.getName())) {
+                target = display; break;
+            }
+        }
+        if (target != null && presentation != null && presentation.isShowing()
+                && presentation.getDisplay().getDisplayId() == target.getDisplayId()) return;
+        dismiss();
+        if (target == null) return;
+        HudPresentation next = new HudPresentation(target);
+        presentation = next;
+        next.setOnDismissListener(dialog -> { if (presentation == next) presentation = null; });
+        try { next.show(); Log.i(TAG, "Lower screen attached display=" + target.getDisplayId()); }
+        catch (WindowManager.InvalidDisplayException | WindowManager.BadTokenException | SecurityException unavailable) {
+            Log.w(TAG, "Lower screen unavailable", unavailable); dismiss();
+        }
+    }
+
+    @Override public void onDisplayAdded(int id) { refresh(); }
+    @Override public void onDisplayRemoved(int id) { refresh(); }
+    @Override public void onDisplayChanged(int id) { refresh(); }
+
+    private final class HudPresentation extends Presentation {
+        final HudView view;
+        HudPresentation(Display display) { super(activity, display); view = new HudView(getContext()); }
+        @Override protected void onCreate(Bundle saved) {
+            super.onCreate(saved);
+            Window window = getWindow();
+            if (window != null) {
+                window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
+                        | WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE);
+                window.getDecorView().setSystemUiVisibility(View.SYSTEM_UI_FLAG_FULLSCREEN
+                        | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
+                        | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
+                        | View.SYSTEM_UI_FLAG_LAYOUT_STABLE);
+            }
+            setContentView(view);
+            if (window != null) window.setLayout(-1, -1);
+        }
+    }
+
+    private final class HudView extends View {
+        private final Paint fallback = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint ink = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private float progressFrom, progressTo, mapFromX, mapFromZ, mapToX, mapToZ;
+        private long motionAt;
+        private String motionIdentity = "";
+        HudView(Context context) { super(context); setFocusable(false); setClickable(false); }
+        private float blend() { return Math.min(1f, Math.max(0f, (SystemClock.uptimeMillis() - motionAt) / 50f)); }
+        private float mix(float from, float to) { return from + (to - from) * blend(); }
+        void acceptMotion() {
+            String identity = state == null ? "" : state.scene + ":" + state.world + ":" + state.stage + ":" + state.area;
+            if (state != null) identity += ":" + state.has(ThorGameState.PROGRESS);
+            if (worldMap != null) identity += ":" + worldMap.world + ":" + worldMap.submap + ":" + worldMap.hasPlayer();
+            boolean reset = !identity.equals(motionIdentity);
+            progressFrom = reset ? 0 : mix(progressFrom, progressTo);
+            mapFromX = reset ? 0 : mix(mapFromX, mapToX); mapFromZ = reset ? 0 : mix(mapFromZ, mapToZ);
+            progressTo = state != null && state.has(ThorGameState.PROGRESS) ? state.progress / 1000f : 0;
+            if (worldMap != null && worldMap.hasPlayer()) { mapToX = worldMap.playerX; mapToZ = worldMap.playerZ; }
+            if (reset) { progressFrom = progressTo; mapFromX = mapToX; mapFromZ = mapToZ; }
+            motionIdentity = identity; motionAt = SystemClock.uptimeMillis();
+        }
+        @Override protected void onDraw(Canvas canvas) {
+            super.onDraw(canvas);
+            canvas.drawColor(Color.rgb(231, 233, 228));
+            float scale = Math.min(getWidth() / 960f, getHeight() / 720f);
+            canvas.save();
+            canvas.translate((getWidth() - 960 * scale) / 2, (getHeight() - 720 * scale) / 2);
+            canvas.scale(scale, scale);
+            if (assets == null) {
+                // A readable missing-assets status; gameplay values never use substitute fonts.
+                fallback.setColor(Color.DKGRAY); fallback.setTextSize(28); fallback.setTextAlign(Paint.Align.CENTER);
+                canvas.drawText("New Super Mario Bros. Wii", 480, 325, fallback);
+                fallback.setTextSize(20);
+                canvas.drawText("Lower-screen artwork unavailable", 480, 373, fallback);
+                canvas.restore(); return;
+            }
+            ThorGameState current = state;
+            if (current != null && current.has(ThorGameState.COURSE)) {
+                String course = current.stage <= 8 ? (current.world + 1) + "-" + (current.stage + 1)
+                        : "World " + (current.world + 1);
+                assets.text(canvas, "WORLD " + course, 300, 48, 48, 470, false);
+                if (current.has(ThorGameState.PLAYER_ONE)) {
+                    assets.image(canvas, "character" + current.character, 700, 43, 48);
+                    assets.text(canvas, "x", 755, 52, 34, 35, false);
+                    assets.text(canvas, String.format(java.util.Locale.ROOT, "%02d", current.lives), 817, 46, 42, 90, true);
+                }
+                assets.panel(canvas, 60, 135, 840, 110);
+                if (current.has(ThorGameState.PROGRESS)) {
+                    ink.setColor(0xff777b73); ink.setStrokeWidth(7); ink.setStrokeCap(Paint.Cap.ROUND);
+                    canvas.drawLine(110, 195, 850, 195, ink);
+                    for (int i = 0; i <= 4; i++) canvas.drawCircle(110 + i * 185, 195, 7, ink);
+                    float marker = 110 + 740 * mix(progressFrom, progressTo);
+                    if (current.has(ThorGameState.PLAYER_ONE))
+                        assets.image(canvas, "character" + current.character, marker, 163, 58);
+                    else { ink.setColor(0xffd3291f); canvas.drawCircle(marker, 195, 13, ink); }
+                } else assets.text(canvas, "Course overview", 480, 167, 32, 740, false);
+                assets.panel(canvas, 60, 285, 510, 130);
+                boolean haveStars = current.has(ThorGameState.STAR_COINS)
+                        && (current.mode == 1 || current.has(ThorGameState.SAVED_STAR_COINS));
+                if (haveStars) {
+                    int collected = current.starCoins | (current.has(ThorGameState.SAVED_STAR_COINS) ? current.savedStarCoins : 0);
+                    for (int i = 0; i < 3; i++) assets.image(canvas,
+                            (collected & (1 << i)) != 0 ? "starCoin" : "starCoinOff", 155 + i * 160, 310, 80);
+                } else assets.text(canvas, "Star Coins", 315, 330, 32, 440, false);
+                assets.panel(canvas, 60, 450, 510, 115);
+                assets.text(canvas, "Score", 315, 460, 26, 440, false);
+                if (current.has(ThorGameState.SCORE)) assets.text(canvas,
+                        String.format(java.util.Locale.ROOT, "%08d", current.score), 315, 503, 44, 440, true);
+                drawReserve(canvas);
+                assets.panel(canvas, 60, 610, 840, 72);
+                if (current.has(ThorGameState.PLAYER_ONE)) {
+                    assets.image(canvas, "coin", 115, 624, 40);
+                    assets.text(canvas, Integer.toString(current.coins), 188, 625, 38, 100, true);
+                }
+                if (current.has(ThorGameState.TIMER)) {
+                    assets.image(canvas, "clock", 700, 624, 40);
+                    assets.text(canvas, Integer.toString(current.seconds), 795, 625, 38, 150, true);
+                }
+            } else if (current != null && current.scene == 3 && worldMap != null) {
+                drawWorldMap(canvas, worldMap);
+            } else {
+                assets.text(canvas, "New Super Mario Bros. Wii", 480, 66, 48, 860, false);
+                String title = "New adventure", message = "Play on the upper screen.";
+                if (current == null) { title = "Starting game"; message = ""; }
+                else if (current.scene == 3) { title = "World map"; message = "Choose a course on the upper screen."; }
+                else if (current.scene == 5 && current.mode == 3) { title = "Demo"; message = ""; }
+                else if (current.scene == 5 && current.mode == 2) { title = "Ready to play"; }
+                assets.text(canvas, title, 480, 294, 60, 800, false);
+                assets.text(canvas, message, 480, 424, 32, 820, false);
+            }
+            canvas.restore();
+            if (isAttachedToWindow() && current != null && (current.has(ThorGameState.PROGRESS) || worldMap != null))
+                postInvalidateOnAnimation();
+        }
+
+        private void drawReserve(Canvas canvas) {
+            ink.setStyle(Paint.Style.FILL); ink.setColor(0xffcacdc5); canvas.drawCircle(735, 420, 145, ink);
+            ink.setColor(Color.WHITE); canvas.drawCircle(735, 417, 135, ink);
+            assets.text(canvas, "Stored item", 735, 302, 26, 240, false);
+            if (reserve != null && reserve.item >= 0) {
+                assets.image(canvas, "reserve" + reserve.item, 735, 355, 126);
+                assets.text(canvas, reserve.queued ? "Dropping" : (reserve.canUse ? "R3" : "Stored"),
+                        735, 506, 28, 220, false);
+            } else assets.text(canvas, "No item", 735, 405, 30, 220, false);
+        }
+
+        private void drawWorldMap(Canvas canvas, ThorWorldMap map) {
+            assets.text(canvas, map.world >= 0 ? "World " + (map.world + 1) : "World map", 480, 55, 52, 840, false);
+            assets.panel(canvas, 60, 145, 840, 440);
+            canvas.save(); canvas.clipRect(78, 163, 882, 567);
+            float width = Math.max(1, map.maxX - map.minX), depth = Math.max(1, map.maxZ - map.minZ);
+            float zoom = Math.min(720 / width, 320 / depth);
+            float offsetX = 480 - (map.minX + map.maxX) * zoom / 2;
+            float offsetZ = 365 - (map.minZ + map.maxZ) * zoom / 2;
+            ink.setColor(0xff777b73); ink.setStrokeWidth(7); ink.setStrokeCap(Paint.Cap.ROUND);
+            for (ThorWorldMap.Point point : map.points) for (int id : point.links) {
+                if (id <= point.id || id >= map.byId.length) continue;
+                ThorWorldMap.Point other = map.byId[id];
+                if (other != null) canvas.drawLine(offsetX + point.x * zoom, offsetZ + point.z * zoom,
+                        offsetX + other.x * zoom, offsetZ + other.z * zoom, ink);
+            }
+            for (ThorWorldMap.Point point : map.points) {
+                if (point.kind != 1) continue;
+                float x = offsetX + point.x * zoom, y = offsetZ + point.z * zoom;
+                ink.setColor(0xff777b73); canvas.drawCircle(x, y, 12, ink);
+                ink.setColor(Color.WHITE); canvas.drawCircle(x, y, 8, ink);
+            }
+            if (map.hasPlayer()) {
+                float x = offsetX + mix(mapFromX, mapToX) * zoom;
+                float y = offsetZ + mix(mapFromZ, mapToZ) * zoom;
+                ink.setColor(0xffd3291f); canvas.drawCircle(x, y, 18, ink);
+                assets.text(canvas, "M", x, y - 14, 25, 30, false);
+            }
+            canvas.restore();
+            assets.text(canvas, "Choose a course on the upper screen.", 480, 623, 30, 840, false);
+        }
+    }
+}
diff --git a/android/app/src/main/java/com/wither/nsmbw/ThorWorldMap.java b/android/app/src/main/java/com/wither/nsmbw/ThorWorldMap.java
