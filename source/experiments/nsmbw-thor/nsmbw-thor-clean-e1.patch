+++ b/android/app/src/main/java/com/wither/nsmbw/ThorGameState.java
@@ -0,0 +1,26 @@
+package com.wither.nsmbw;
+
+/** Read-only lower-display data. Field validity is explicit; unavailable is never a fake zero. */
+public final class ThorGameState {
+    public static final int SCENE = 1, COURSE = 2, PLAYER_ONE = 4, TIMER = 8, STOP_FLAGS = 16,
+            PROGRESS = 32, STAR_COINS = 64, SCORE = 128, SAVED_STAR_COINS = 256;
+    public final long sequence;
+    public final int fields, scene, mode, world, stage, character, lives, coins, seconds;
+    public final boolean gameStopped;
+    public final int progress, starCoins, savedStarCoins, score, area, checkpoint, playerXQ4, areaWidthQ4;
+
+    private ThorGameState(int[] data) {
+        sequence = Integer.toUnsignedLong(data[1]);
+        fields = data[2]; scene = data[3]; mode = data[4]; world = data[5]; stage = data[6];
+        character = data[7]; lives = data[8]; coins = data[9]; seconds = data[10]; gameStopped = data[11] != 0;
+        progress = data[12]; starCoins = data[13]; savedStarCoins = data[14]; score = data[15];
+        area = data[16]; checkpoint = data[17]; playerXQ4 = data[18]; areaWidthQ4 = data[19];
+    }
+    public boolean has(int field) { return (fields & field) == field; }
+
+    /** Call after SDL loaded the native library. Data is copied under a short native mutex. */
+    public static ThorGameState read() {
+        final int[] data = GameActivity.nativeReadThorState();
+        return data != null && data.length == 20 && data[0] == 2 ? new ThorGameState(data) : null;
+    }
+}
diff --git a/android/app/src/main/java/com/wither/nsmbw/ThorLaunchActivity.java b/android/app/src/main/java/com/wither/nsmbw/ThorLaunchActivity.java
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/com/wither/nsmbw/ThorLaunchActivity.java
@@ -0,0 +1,53 @@
+package com.wither.nsmbw;
+
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.os.Bundle;
+import android.widget.Toast;
+
+/** Entry point for the existing Thor Wii launcher. No native library is loaded in this process. */
+public final class ThorLaunchActivity extends Activity {
+    static final String EXTRA_SESSION = "thor_launcher_session";
+    private static final String ACTION_PLAY = "dev.thor.launcher.action.PLAY_GAME";
+    private static final ComponentName HOME = new ComponentName(
+            "com.driftdroid.android.thor", "com.driftdroid.android.ModePickerActivity");
+
+    @Override protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        final Intent request = getIntent();
+        if (!BuildConfig.THOR_BUILD || request == null
+                || !ACTION_PLAY.equals(request.getAction())
+                || request.getIntExtra("thor_protocol", 0) != 1
+                || !"nsmbw".equals(request.getStringExtra("thor_game"))) {
+            finish();
+            return;
+        }
+        // Validation includes hashing main.dol. Do file work before handing off to SDL's :game.
+        new Thread(() -> {
+            final boolean ready = AppFiles.gameReady(this);
+            runOnUiThread(() -> {
+                if (isFinishing() || isDestroyed()) return;
+                final Intent next = new Intent(this, ready ? GameActivity.class : LauncherActivity.class)
+                        .putExtra(EXTRA_SESSION, true);
+                if (!ready) next.putExtra(LauncherActivity.EXTRA_SHOW_START_MENU, true);
+                startActivity(next);
+                finish();
+            });
+        }, "ThorNsmbwLaunch").start();
+    }
+
+    /** The target is fixed: callers cannot request an arbitrary package or component. */
+    static boolean returnToLibrary(Activity activity) {
+        try {
+            activity.startActivity(new Intent(Intent.ACTION_MAIN).setComponent(HOME)
+                    .addCategory(Intent.CATEGORY_LAUNCHER)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT | Intent.FLAG_ACTIVITY_SINGLE_TOP));
+            return true;
+        } catch (ActivityNotFoundException | SecurityException unavailable) {
+            Toast.makeText(activity, "The Thor Wii launcher is unavailable.", Toast.LENGTH_LONG).show();
+            return false;
+        }
+    }
+}
