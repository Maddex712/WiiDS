 plugins {
     id 'com.android.application'
 }
+
+def thorBuild = providers.gradleProperty('thorBuild').orNull == 'true'
+def thorDiscRevision = providers.gradleProperty('thorDiscRevision').orElse('2').get().toInteger()
+if (!(thorDiscRevision in [1, 2])) throw new GradleException('thorDiscRevision must be 1 or 2.')
+def discRevision = thorBuild ? thorDiscRevision : 1
+def discDolHash = discRevision == 2
+        ? '0373b4dbffd7c9da9d27eb7257a7677877a3e33ceb81818bab1daa93560b9907'
+        : '166eb6b7cca21418e316a6cfbf1bfbf0a213eb8f6396d42126a1482bb764a955'
 
 android {
     namespace 'com.wither.nsmbw'
     compileSdk 34
 
     defaultConfig {
-        applicationId 'com.wither.nsmbw'
+        applicationId thorBuild ? 'com.wither.nsmbw.thor' : 'com.wither.nsmbw'
+        buildConfigField 'boolean', 'THOR_BUILD', thorBuild.toString()
+        buildConfigField 'int', 'DISC_REVISION', discRevision.toString()
+        buildConfigField 'String', 'DOL_SHA256', '"' + discDolHash + '"'
+        manifestPlaceholders = [thorExported: thorBuild.toString()]
         // Guest RAM uses memfd_create, which bionic has from Android 11 (API 30).
         minSdk 30
         targetSdk 34
@@ -17,6 +29,8 @@
             abiFilters 'arm64-v8a'
         }
     }
+
+    buildFeatures { buildConfig true }
 
     buildTypes {
         release {
@@ -52,3 +66,43 @@
         }
     }
 }
+
+// Compilation checks may run before the game exists. APK packaging must have a stamped native
+// build for the same disc revision, so a Java-only shell cannot become a purported playable APK.
+if (thorBuild) {
+    def verifyThorNative = tasks.register('verifyThorNative') {
+        doLast {
+            def nativeRoot = file('../native')
+            def receiptFile = new File(nativeRoot, 'thor-native.json')
+            def library = new File(nativeRoot, 'jniLibs/arm64-v8a/libmain.so')
+            if (!receiptFile.isFile() || !library.isFile()) {
+                throw new GradleException('Stage a verified Thor native build for this disc revision before packaging an APK.')
+            }
+            def receipt = new groovy.json.JsonSlurper().parse(receiptFile)
+            if (receipt.schema != 1 || receipt.disc_id != 'SMNE01' || receipt.disc_revision != discRevision
+                    || receipt.dol_sha256 != discDolHash) {
+                throw new GradleException('The staged native build does not match Thor USA revision ' + discRevision + '.')
+            }
+            def hash = java.security.MessageDigest.getInstance('SHA-256')
+            library.withInputStream { stream ->
+                byte[] buffer = new byte[65536]
+                int n
+                while ((n = stream.read(buffer)) != -1) hash.update(buffer, 0, n)
+            }
+            if (hash.digest().encodeHex().toString() != receipt.library_sha256) {
+                throw new GradleException('The staged native library differs from its build receipt.')
+            }
+            for (name in ['dsp_coef.bin', 'cacert.pem', 'initial_pipeline_cache.db']) {
+                if (!new File(nativeRoot, 'assets/runtime/' + name).isFile()) {
+                    throw new GradleException('Missing runtime asset: ' + name)
+                }
+            }
+            if (!new File(nativeRoot, 'assets/runtime/wii_bootstrap').isDirectory()) {
+                throw new GradleException('Missing runtime NAND bootstrap.')
+            }
+        }
+    }
+    tasks.configureEach {
+        if (name in ['packageDebug', 'packageRelease']) dependsOn verifyThorNative
+    }
+}
