 }
+
+// Compilation checks may run before the game exists. APK packaging must have a stamped native
+// build for the same disc revision, so a Java-only shell cannot become a purported playable APK.
+if (thorBuild) {
+    def verifyThorNative = tasks.register('verifyThorNative') {
+        doLast {
+            def nativeRoot = file('../native')
+            def receiptFile = new File(nativeRoot, 'thor-native.json')
+            def library = new File(nativeRoot, 'jniLibs/arm64-v8a/libmain.so')
+            if (!receiptFile.isFile() || !library.isFile()) {
+                throw new GradleException('Stage a verified Thor E2 native build before packaging an APK.')
+            }
+            def receipt = new groovy.json.JsonSlurper().parse(receiptFile)
+            if (receipt.schema != 1 || receipt.disc_id != 'SMNE01' || receipt.disc_revision != 2
+                    || receipt.dol_sha256 != '0373b4dbffd7c9da9d27eb7257a7677877a3e33ceb81818bab1daa93560b9907') {
+                throw new GradleException('The staged native build does not match Thor USA revision 2.')
+            }
+            def hash = java.security.MessageDigest.getInstance('SHA-256')
+            library.withInputStream { stream ->
+                byte[] buffer = new byte[65536]
+                int n
+                while ((n = stream.read(buffer)) != -1) hash.update(buffer, 0, n)
+            }
+            if (hash.digest().encodeHex().toString() != receipt.library_sha256) {
+                throw new GradleException('The staged native library differs from its build receipt.')
+            }
+            for (name in ['dsp_coef.bin', 'cacert.pem', 'initial_pipeline_cache.db']) {
+                if (!new File(nativeRoot, 'assets/runtime/' + name).isFile()) {
+                    throw new GradleException('Missing runtime asset: ' + name)
+                }
+            }
+            if (!new File(nativeRoot, 'assets/runtime/wii_bootstrap').isDirectory()) {
+                throw new GradleException('Missing runtime NAND bootstrap.')
+            }
+        }
+    }
+    tasks.configureEach {
+        if (name in ['packageDebug', 'packageRelease']) dependsOn verifyThorNative
+    }
+}
