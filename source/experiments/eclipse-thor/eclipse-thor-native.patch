+static int s_captureW, s_captureH;
+int GXPC_CaptureEFB(uint8_t* rgba, int w, int h) {
+    if (!rgba || w <= 0 || h <= 0) return 0;
+    flushBatch();
+    glcInvalidate();
+    if (!s_captureFbo || s_captureW != w || s_captureH != h) {
+        if (!s_captureTex) glGenTextures(1, &s_captureTex);
+        glBindTexture(GL_TEXTURE_2D, s_captureTex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        if (!s_captureFbo) glGenFramebuffers(1, &s_captureFbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, s_captureFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, s_captureTex, 0);
+        s_captureW = w;
+        s_captureH = h;
+    }
+    const int W = scaled(s_efbW), H = scaled(EFB_H);
+    const GLuint source = efbReadFbo(0, 0, INT32_MAX, INT32_MAX, GL_COLOR_BUFFER_BIT);
+    glDisable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, source);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, s_captureFbo);
+    glBlitFramebuffer(0, 0, W, H, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    glBindFramebuffer(GL_FRAMEBUFFER, s_captureFbo);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+    glBindFramebuffer(GL_FRAMEBUFFER, s_efbFbo);
