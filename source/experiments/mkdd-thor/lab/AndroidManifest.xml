<?xml version="1.0" encoding="utf-8"?>
<!-- Private Double Dash lab app: installs beside WiiDS and never replaces it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="dev.thor.mkdd.lab"
          android:versionCode="1"
          android:versionName="0.1-lab">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />

    <application android:label="Double Dash lab"
                 android:hasCode="true"
                 android:debuggable="true"
                 android:extractNativeLibs="true"
                 android:allowBackup="false">
        <activity android:name="dev.thor.mkdd.MkddGameActivity"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:screenOrientation="landscape"
                  android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
                  android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="wiids_mkdd_game" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
