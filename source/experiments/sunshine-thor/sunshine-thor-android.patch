diff --git a/android/app/src/main/java/dev/chasem/smslauncher/ThorStorage.java b/android/app/src/main/java/dev/chasem/smslauncher/ThorStorage.java
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/dev/chasem/smslauncher/ThorStorage.java
@@ -0,0 +1,41 @@
+package dev.chasem.smslauncher;
+
+import android.content.Context;
+import android.content.Intent;
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+
+/** Thor owns one separate app-scoped data tree; launch intents cannot select paths. */
+public final class ThorStorage {
+    private ThorStorage() {}
+    public static File root(Context context) {
+        File root = context.getExternalFilesDir(null);
+        if (root == null) throw new IllegalStateException("Sunshine storage is unavailable.");
+        return root;
+    }
+    public static void validateDisc(Context context) throws IOException {
+        validateDisc(new File(root(context), "disc/game.iso"));
+    }
+    public static void validateDisc(File disc) throws IOException {
+        if (disc.length() != 1459978240L) throw new IOException("Import the verified US revision 0 Sunshine disc first.");
+        try (RandomAccessFile in = new RandomAccessFile(disc, "r")) {
+            byte[] h = new byte[32]; in.readFully(h);
+            if (!new String(h, 0, 6, java.nio.charset.StandardCharsets.US_ASCII).equals("GMSE01")
+                || h[6] != 0 || h[7] != 0 || h[28] != (byte)0xc2 || h[29] != 0x33
+                || h[30] != (byte)0x9f || h[31] != 0x3d)
+                throw new IOException("Sunshine requires a US revision 0 GameCube disc.");
+        }
+    }
+    public static boolean returnToLibrary(Context context) {
+        try {
+            context.startActivity(new Intent().setComponent(new android.content.ComponentName(
+                "com.driftdroid.android.thor", "com.driftdroid.android.ModePickerActivity"))
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT));
+            return true;
+        } catch (android.content.ActivityNotFoundException | SecurityException e) {
+            android.util.Log.w("SMS-Thor", "Shared library is unavailable", e);
+            return false;
+        }
+    }
+}
diff --git a/android/app/src/main/java/dev/chasem/smslauncher/ThorSessionShutdown.java b/android/app/src/main/java/dev/chasem/smslauncher/ThorSessionShutdown.java
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/dev/chasem/smslauncher/ThorSessionShutdown.java
@@ -0,0 +1,24 @@
+package dev.chasem.smslauncher;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** Bounds a terminal session teardown; never armed for pause, Home or sleep. */
+final class ThorSessionShutdown implements AutoCloseable {
+    private final AtomicBoolean complete = new AtomicBoolean();
+    private final Thread watchdog;
+    ThorSessionShutdown(long graceMillis, Runnable diagnostics, Runnable terminate) {
+        watchdog = new Thread(() -> {
+            try { Thread.sleep(graceMillis); }
+            catch (InterruptedException done) { return; }
+            if (complete.compareAndSet(false, true)) {
+                try { diagnostics.run(); }
+                finally { terminate.run(); }
+            }
+        }, "ThorSessionExit");
+        watchdog.setDaemon(true);
+        watchdog.start();
+    }
+    @Override public void close() {
+        if (complete.compareAndSet(false, true)) watchdog.interrupt();
+    }
+}
diff --git a/android/app/src/main/java/com/wither/sms/ThorLaunchActivity.java b/android/app/src/main/java/com/wither/sms/ThorLaunchActivity.java
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/com/wither/sms/ThorLaunchActivity.java
@@ -0,0 +1,33 @@
+package com.wither.sms;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import dev.chasem.smslauncher.GameActivity;
+import dev.chasem.smslauncher.LauncherActivity;
+import dev.chasem.smslauncher.ThorStorage;
+
+/** Explicit, versioned transport from the shared Thor library. */
+public final class ThorLaunchActivity extends Activity {
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        Intent request = getIntent();
+        if (!"dev.thor.launcher.action.PLAY_GAME".equals(request.getAction())
+            || request.getIntExtra("thor_protocol", -1) != 1
+            || !"sunshine".equals(request.getStringExtra("thor_game"))) {
+            android.util.Log.w("SMS-Thor", "Rejected unknown launch protocol");
+            finish(); return;
+        }
+        try {
+            ThorStorage.validateDisc(this);
+            LauncherActivity.prepareGame(this);
+            startActivity(new Intent(this, GameActivity.class).putExtra("thor_library", true)
+                .addFlags(Intent.FLAG_ACTIVITY_REORDER_TO_FRONT | Intent.FLAG_ACTIVITY_SINGLE_TOP));
+        } catch (java.io.IOException | IllegalStateException e) {
+            android.util.Log.e("SMS-Thor", "Sunshine data is not ready", e);
+            startActivity(new Intent(this, LauncherActivity.class));
+            android.widget.Toast.makeText(this, e.getMessage(), android.widget.Toast.LENGTH_LONG).show();
+        }
+        finish();
+    }
+}
