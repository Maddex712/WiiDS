+void setButtonMap(const int* map) {
+    for (int i = 0; i < BTN_COUNT; i++) {
+        const int action = map != nullptr ? map[i] : kDefaultButtonMap[i];
+        sButtonMap[i] = action >= 0 && action < ACT_COUNT ? action : ACT_NONE;
+    }
