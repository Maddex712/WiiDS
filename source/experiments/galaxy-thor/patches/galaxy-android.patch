diff --git a/decomp/src/Game/System/ThorLowerState.cpp b/decomp/src/Game/System/ThorLowerState.cpp
new file mode 100644
index 0000000..80d6db0
--- /dev/null
+++ b/decomp/src/Game/System/ThorLowerState.cpp
@@ -0,0 +1,305 @@
+// AYN Thor lower screen: samples Super Mario Galaxy's state on the game thread, once a frame
+// after the scene's update (GameSystem::frameLoop), into a ThorLowerState and hands it to the
+// platform (port_thor_lower_commit, platform/mobile/thor/ThorLowerBridge.cpp). Read-only: only
+// the game's own query functions are called, and only in the scene states where they are valid;
+// nothing here changes progression, inventory, camera or saves. No heap allocation: the state
+// lives in a static buffer (scene heaps come and go under this thread).
+#ifdef TARGET_MOBILE
+
+#include "Game/Scene/GameScene.hpp"
+#include "Game/Scene/ScenarioSelectScene.hpp"
+#include "Game/Scene/SceneObjHolder.hpp"
+#include "Game/System/GalaxyStatusAccessor.hpp"
+#include "Game/System/GameDataConst.hpp"
+#include "Game/System/GameSystem.hpp"
+#include "Game/System/GameSystemSceneController.hpp"
+#include "Game/System/ScenarioDataParser.hpp"
+#include "Game/Util/DemoUtil.hpp"
+#include "Game/Util/EventUtil.hpp"
+#include "Game/Util/MessageUtil.hpp"
+#include "Game/Util/PlayerUtil.hpp"
+#include "Game/Util/SceneUtil.hpp"
+#include "Game/Util/SingletonHolder.hpp"
+#include "port/port.h"
+#include "port/thor_lower.h"
+
+#include <stdio.h>
+#include <string.h>
+
+// GameScene's step (GameScene.cpp, beside its nerves): a ThorLowerPhase.
+int thorGameScenePhase(const GameScene* pScene);
+// Whether the title ran in this update (FileSelector.cpp); taking it clears it.
+bool thorFileSelectorTakeTitle();
+// Whether the prologue's picture book ran in this update (ProloguePictureBook.cpp); taking it clears it.
+bool thorStorybookTake();
+
+extern "C" __attribute__((weak)) void port_thor_lower_commit(const ThorLowerState* state);
+
+namespace {
+    bool sTitleLive;
+    s32 sStorybookHold;  // frames the picture book still counts as open (bridges a skipped update)
+    ThorLowerState sState;
+    char sLastStage[32];
+    s32 sLastScenario = -1;
+    s32 sLastPhase = -1;
+    s32 sLastTotalStars = -1;
+    s32 sGeneration;
+    s32 sFrame;
+    s32 sLedgerAge = 1 << 20;
+
+    // Game text (UTF-16 with -fshort-wchar) without its control tags: a tag is 0x001A, then a
+    // unit whose high byte is the tag's whole size in bytes.
+    void copyText(uint16_t* pOut, s32 capacity, const wchar_t* pText) {
+        s32 n = 0;
+        if (pText != nullptr) {
+            for (s32 i = 0; pText[i] != 0 && n + 1 < capacity && i < 512; i++) {
+                const uint16_t unit = static_cast< uint16_t >(pText[i]);
+                if (unit == 0x001A) {
+                    const s32 size = static_cast< uint16_t >(pText[i + 1]) >> 8;
+                    if (size < 4) {
+                        break;
+                    }
+                    i += size / 2 - 1;
+                    continue;
+                }
+                if (unit == 0x000A) {
+                    if (n > 0 && pOut[n - 1] != 0x20) {
+                        pOut[n++] = 0x20;
+                    }
+                    continue;
+                }
+                pOut[n++] = unit;
+            }
+        }
+        while (n > 0 && pOut[n - 1] == 0x20) {
+            n--;
+        }
+        pOut[n] = 0;
+        for (s32 i = n + 1; i < capacity; i++) {
+            pOut[i] = 0;
+        }
+    }
+
+    bool isScene(const GameSystemSceneController* pController, const char* pName) {
+        return strcmp(pController->mCurrSceneControlInfo.mScene, pName) == 0;
+    }
+
+    s32 phaseOf(GameSystemSceneController* pController) {
+        if (pController->isChangingScene()) {
+            return THOR_PHASE_LOADING;
+        }
+        if (pController->mScenarioSelectScene != nullptr && pController->mScenarioSelectScene->isActive() &&
+            pController->mScenarioSelectScene->isScenarioSelecting()) {
+            return THOR_PHASE_MISSION_SELECT;
+        }
+        if (isScene(pController, "Logo")) {
+            return THOR_PHASE_LOGO;
+        }
+        if (isScene(pController, "Intermission") || isScene(pController, "PlayTimer")) {
+            return THOR_PHASE_INTERMISSION;
+        }
+        if (!isScene(pController, "Game") || pController->mScene == nullptr) {
+            return THOR_PHASE_NONE;
+        }
+        if (strcmp(pController->mCurrSceneControlInfo.mStage, "FileSelect") == 0) {
+            return THOR_PHASE_FILE_SELECT;
+        }
+        if (!pController->isSceneInitializeState(SceneInitializeState_End)) {
+            return THOR_PHASE_LOADING;
+        }
+        s32 phase = thorGameScenePhase(static_cast< const GameScene* >(pController->mScene));
+        if (phase == THOR_PHASE_PLAY && MR::isDemoActive()) {
+            phase = THOR_PHASE_CUTSCENE;
+        }
+        return phase;
+    }
+
+    // This galaxy's Power Stars and the selected mission's name.
+    void sampleGalaxy(const char* pStage, s32 selected) {
+        GalaxyStatusAccessor accessor = MR::makeGalaxyStatusAccessor(pStage);
+        if (accessor.mScenarioData == nullptr) {
+            return;
+        }
+        const s32 stars = accessor.getPowerStarNum();
+        if (stars <= 0 || stars > THOR_LOWER_STARS) {
+            return;
+        }
+        sState.galaxyStars = stars;
+        sState.galaxyStarsOwned = accessor.getPowerStarNumOwned();
+        for (s32 i = 0; i < THOR_LOWER_STARS; i++) {
+            s32 flags = 0;
+            const s32 scenario = i + 1;
+            if (scenario <= stars) {
+                if (accessor.hasPowerStar(scenario)) flags |= THOR_STAR_OWNED;
+                if (accessor.isValidNormalComet(scenario)) flags |= THOR_STAR_COMET;
+                if (accessor.isHiddenStar(scenario)) flags |= THOR_STAR_HIDDEN;
+                if (accessor.isValidCoin100(scenario)) flags |= THOR_STAR_PURPLE;
+                if (GameDataConst::isGrandStar(pStage, scenario)) flags |= THOR_STAR_GRAND;
+                if ((flags & THOR_STAR_OWNED) && MR::isPowerStarGreen(pStage, scenario)) flags |= THOR_STAR_GREEN;
+                if (scenario == selected) flags |= THOR_STAR_SELECTED;
+            }
+            sState.starFlags[i] = flags;
+            // Names only for missions the player has earned or is playing (the game reveals no more).
+            const bool named = scenario <= stars && (flags & (THOR_STAR_OWNED | THOR_STAR_SELECTED)) != 0;
+            copyText(sState.starNames[i], THOR_LOWER_NAME, named ? MR::getScenarioNameOnCurrentLanguage(pStage, scenario) : nullptr);
+        }
+        sState.valid |= THOR_VALID_STARS;
+    }
+
+    // The Observatory ledger: open galaxies with stars, as the game's Power Star list builds it.
+    void sampleLedger(const char* pStage) {
+        s32 count = 0;
+        for (ScenarioDataIter iter = MR::makeBeginScenarioDataIter(); !iter.isEnd() && count < THOR_LOWER_GALAXIES; iter.goNext()) {
+            GalaxyStatusAccessor accessor = iter.makeAccessor();
+            if (accessor.getPowerStarNum() == 0 || !MR::isOnGameEventFlagGalaxyOpen(accessor.getName())) {
+                continue;
+            }
+            sState.galaxyOwned[count] = accessor.getPowerStarNumOwned();
+            sState.galaxyTotal[count] = accessor.getPowerStarNum();
+            sState.galaxyFlags[count] = (accessor.isCompleted() ? THOR_GALAXY_COMPLETED : 0) |
+                                        (strcmp(accessor.getName(), pStage) == 0 ? THOR_GALAXY_CURRENT : 0);
+            copyText(sState.galaxyNames[count], THOR_LOWER_SHORT, MR::getGalaxyNameShortOnCurrentLanguage(accessor.getName()));
+            count++;
+        }
+        for (s32 i = count; i < THOR_LOWER_GALAXIES; i++) {
+            sState.galaxyOwned[i] = sState.galaxyTotal[i] = sState.galaxyFlags[i] = 0;
+            sState.galaxyNames[i][0] = 0;
+        }
+        sState.galaxyCount = count;
+        sState.valid |= THOR_VALID_LEDGER;
+    }
+}  // namespace
+
+// The title is space itself (its logo is 2D, drawn after HUD_BEGIN), so GameScene::draw marks
+// the frames it draws for the lower screen's live space (PORT_GX_MARK_THOR_SPACE). The file
+// screens add 3D file planets and heads, which the lower screen does not mirror, and a galaxy's
+// sky is drawn among its planets: there nothing is marked and the last title picture stays.
+// Decided after this update, for the frame drawn from it, so the camera cut into the file screens
+// is never taken.
+bool thorLowerTitleLive() {
+    return sTitleLive;
+}
+
+void thorLowerPublish() {
+    const bool title = thorFileSelectorTakeTitle();
+    if (thorStorybookTake()) sStorybookHold = 10;
+    else if (sStorybookHold > 0) sStorybookHold--;
+    if (port_thor_lower_commit == nullptr) {
+        sTitleLive = false;
+        return;
+    }
+    sFrame++;
+    GameSystem* pSystem = SingletonHolder< GameSystem >::get();
+    GameSystemSceneController* pController = pSystem != nullptr ? pSystem->mSceneController : nullptr;
+    const s32 phase = pController != nullptr ? phaseOf(pController) : THOR_PHASE_NONE;
+    sTitleLive = title && phase == THOR_PHASE_FILE_SELECT;
+    const char* pStage = pController != nullptr ? pController->mCurrSceneControlInfo.mStage : "";
+    const s32 scenario = pController != nullptr ? pController->getCurrentScenarioNo() : 0;
+    const s32 selected = pController != nullptr ? pController->getCurrentSelectedScenarioNo() : 0;
+
+    // Anything that changes what the screen describes starts a new generation; the UI drops the old
+    // picture rather than showing a previous galaxy as live.
+    const bool newStage = strncmp(pStage, sLastStage, sizeof sLastStage) != 0;
+    if (newStage || scenario != sLastScenario || (phase == THOR_PHASE_LOADING) != (sLastPhase == THOR_PHASE_LOADING)) {
+        sGeneration++;
+        strncpy(sLastStage, pStage, sizeof sLastStage - 1);
+        sLastScenario = scenario;
+        sLedgerAge = 1 << 20;
+    }
+    sLastPhase = phase;
+
+
+    sState.version = THOR_LOWER_VERSION;
+    sState.phase = phase;
+    sState.generation = sGeneration;
+    sState.frame = sFrame;
+    sState.valid = 0;
+    sState.flags = 0;
+
+    const bool inGalaxy = phase == THOR_PHASE_MISSION_SELECT || phase == THOR_PHASE_PLAY || phase == THOR_PHASE_PAUSE ||
+                          phase == THOR_PHASE_STAR_GET || phase == THOR_PHASE_CUTSCENE || phase == THOR_PHASE_MISS ||
+                          phase == THOR_PHASE_MAP;
+    if (!inGalaxy || pStage[0] == 0) {
+        // Diagnostics only (never shown to the player): "scene/stage".
+        memset(sState.stage, 0, sizeof sState.stage);
+        if (pController != nullptr)
+            snprintf(sState.stage, sizeof sState.stage, "%.15s/%.15s", pController->mCurrSceneControlInfo.mScene, pStage);
+        port_thor_lower_commit(&sState);
+        return;
+    }
+
+    strncpy(sState.stage, pStage, sizeof sState.stage - 1);
+    sState.stage[sizeof sState.stage - 1] = 0;
+    copyText(sState.galaxyName, THOR_LOWER_NAME, MR::getGalaxyNameOnCurrentLanguage(pStage));
+    sState.valid |= THOR_VALID_STAGE;
+
+    const bool astro = MR::isStageAstroLocation();
+    if (astro) sState.flags |= THOR_FLAG_ASTRO;
+    if (MR::isPlayerLuigi()) sState.flags |= THOR_FLAG_LUIGI;
+    if (port_is_infinite_starbits()) sState.flags |= THOR_FLAG_INFINITE_BITS;
+    if (pController->isScenarioDecided()) sState.flags |= THOR_FLAG_SCENARIO_DECIDED;
+    if (sStorybookHold > 0) sState.flags |= THOR_FLAG_STORYBOOK;
+
+    // Where Mario is, for the lower screen's map.
+    if (MR::isExistMario()) {
+        const TVec3f* pPos = MR::getPlayerPos();
+        TVec3f up(0.0f, 1.0f, 0.0f);
+        MR::getPlayerUpVec(&up);
+        sState.marioPos[0] = pPos->x; sState.marioPos[1] = pPos->y; sState.marioPos[2] = pPos->z;
+        sState.marioUp[0] = up.x; sState.marioUp[1] = up.y; sState.marioUp[2] = up.z;
+        sState.valid |= THOR_VALID_MARIO;
+    }
+
+    const s32 mission = selected > 0 ? selected : scenario;
+    sState.scenarioNo = scenario;
+    sState.selectedScenarioNo = selected;
+    if (!astro && mission > 0) {
+        copyText(sState.scenarioName, THOR_LOWER_NAME, MR::getScenarioNameOnCurrentLanguage(pStage, mission));
+        sState.valid |= THOR_VALID_SCENARIO;
+    } else {
+        sState.scenarioName[0] = 0;
+    }
+
+    // Counters exist only while the stage's own result holder does (not on the mission select).
+    const bool counters = phase != THOR_PHASE_MISSION_SELECT && MR::isExistSceneObj(SceneObj_ScenePlayingResult);
+    if (counters) {
+        sState.totalStars = MR::getPowerStarNum();
+        sState.starBitsRun = MR::getStarPieceNum();
+        sState.starBitsBanked = MR::getStockedStarPieceNum();
+        sState.coins = MR::getCoinNum();
+        sState.lives = MR::getPlayerLeft();
+        sState.purpleCoins = MR::getPurpleCoinNum();
+        sState.valid |= THOR_VALID_COUNTERS;
+    } else {
+        sState.totalStars = MR::getPowerStarNum();
+        sState.starBitsBanked = MR::getStockedStarPieceNum();
+        sState.lives = MR::getPlayerLeft();
+    }
+
+    // Stars and the ledger change rarely: re-read on a new generation, a new star, or twice a second.
+    if (sState.totalStars != sLastTotalStars) {
+        sLastTotalStars = sState.totalStars;
+        sLedgerAge = 1 << 20;
+    }
+    if (++sLedgerAge >= 30) {
+        sLedgerAge = 0;
+        if (astro) {
+            sampleLedger(pStage);
+            sState.galaxyStars = sState.galaxyStarsOwned = 0;
+        } else {
+            sampleGalaxy(pStage, mission);
+            sState.galaxyCount = 0;
+        }
+    } else {
+        // Unchanged since the last read: keep the earlier result's validity.
+        if (sState.galaxyStars > 0 && !astro) sState.valid |= THOR_VALID_STARS;
+        if (sState.galaxyCount > 0 && astro) sState.valid |= THOR_VALID_LEDGER;
+    }
+    if (!astro && sState.galaxyStars > 0 && mission > 0 && mission <= sState.galaxyStars &&
+        (sState.starFlags[mission - 1] & THOR_STAR_PURPLE) && counters) {
+        sState.valid |= THOR_VALID_PURPLE;
+    }
+    port_thor_lower_commit(&sState);
+}
+
+#endif  // TARGET_MOBILE
diff --git a/decomp/src/Game/System/ThorWorldState.cpp b/decomp/src/Game/System/ThorWorldState.cpp
new file mode 100644
index 0000000..c2b7af8
--- /dev/null
+++ b/decomp/src/Game/System/ThorWorldState.cpp
@@ -0,0 +1,183 @@
+// AYN Thor lower screen: the live state of the stage's placed world pieces (port/thor_world.h).
+//
+// Every object the placement files create (PlacementInfoOrdered::initPlacement) is noted with its
+// zone and l_id when it is a LiveActor; once a frame, after the scene's update and calcAnim
+// (GameSystem::frameLoop), each noted actor's state is copied out: whether it is alive, whether
+// its model is hidden, and its model's base matrix and scale. The lower screen draws its baked
+// copy of each piece from that, so pieces appear, move and vanish as the game's do.
+//
+// Read-only: only the actors' own fields and getBaseMtx are read; nothing is changed. The scene is
+// destroyed on another thread (GameSystemSceneController::destroyScene, run asynchronously), so
+// the table is cleared under a lock before the scene is deleted and every read holds that lock.
+// No heap allocation: static buffers only.
+#ifdef TARGET_MOBILE
+
+#include "Game/LiveActor/AllLiveActorGroup.hpp"
+#include "Game/LiveActor/LiveActor.hpp"
+#include "Game/MapObj/PlantGroup.hpp"
+#include "Game/Util/JMapUtil.hpp"
+#include "Game/Util/SceneUtil.hpp"
+#include "Game/Util/StringUtil.hpp"
+#include "port/thor_world.h"
+
+#include <string.h>
+
+extern "C" __attribute__((weak)) void port_thor_world_commit(const ThorWorldHeader* pHeader, const ThorWorldPiece* pPieces,
+                                                             uint32_t count);
+
+namespace {
+    struct Entry {
+        LiveActor* mActor;
+        s16 mZone;
+        s16 mChild;
+        s32 mLinkId;
+    };
+
+    Entry sEntries[THOR_WORLD_PIECES];
+    s32 sCount;
+    s32 sZoneIds[THOR_WORLD_ZONES];
+    ThorWorldHeader sHeader;
+    ThorWorldPiece sPieces[THOR_WORLD_PIECES];
+    u32 sGeneration;
+    bool sChanged;
+    int sLock;
+
+    // Held for microseconds by the game thread and the scene loader / destroyer threads.
+    struct Guard {
+        Guard() {
+            while (__atomic_exchange_n(&sLock, 1, __ATOMIC_ACQUIRE) != 0) {
+            }
+        }
+        ~Guard() { __atomic_store_n(&sLock, 0, __ATOMIC_RELEASE); }
+    };
+
+    // Whether [pObj] is a LiveActor: every LiveActor joins the scene's all-actor group as it is
+    // built, so a just-created object sits near the group's end (after its own sub-actors).
+    LiveActor* asLiveActor(NameObj* pObj) {
+        AllLiveActorGroup* pGroup = MR::getAllLiveActorGroup();
+        if (pGroup == nullptr) {
+            return nullptr;
+        }
+        const s32 n = pGroup->getObjNum();
+        for (s32 i = n - 1; i >= 0 && i >= n - 1024; i--) {
+            if (pGroup->getObj(i) == pObj) {
+                return static_cast< LiveActor* >(pObj);
+            }
+        }
+        return nullptr;
+    }
+
+    s32 zoneSlot(s32 zoneId) {
+        for (u32 i = 0; i < sHeader.zoneCount; i++) {
+            if (sZoneIds[i] == zoneId) {
+                return static_cast< s32 >(i);
+            }
+        }
+        if (sHeader.zoneCount >= THOR_WORLD_ZONES) {
+            return -1;
+        }
+        const s32 slot = static_cast< s32 >(sHeader.zoneCount++);
+        sZoneIds[slot] = zoneId;
+        const char* pName = MR::getZoneNameFromZoneId(zoneId);
+        memset(sHeader.zones[slot], 0, THOR_WORLD_ZONE_NAME);
+        if (pName != nullptr) {
+            strncpy(sHeader.zones[slot], pName, THOR_WORLD_ZONE_NAME - 1);
+        }
+        return slot;
+    }
+}  // namespace
+
+// PlacementInfoOrdered::initPlacement, after each placed object's init.
+void thorWorldRegister(NameObj* pObj, const JMapInfoIter& rIter) {
+    if (port_thor_world_commit == nullptr || pObj == nullptr) {
+        return;
+    }
+    LiveActor* pActor = asLiveActor(pObj);
+    s32 linkId = -1;
+    if (pActor == nullptr || !MR::getJMapInfoLinkID(rIter, &linkId)) {
+        return;
+    }
+    const s32 zoneId = MR::getPlacedZoneId(rIter);
+    Guard guard;
+    if (sCount >= THOR_WORLD_PIECES) {
+        return;
+    }
+    const s32 slot = zoneSlot(zoneId);
+    if (slot < 0) {
+        return;
+    }
+    Entry& rEntry = sEntries[sCount++];
+    rEntry.mActor = pActor;
+    rEntry.mZone = static_cast< s16 >(slot);
+    rEntry.mChild = 0;
+    rEntry.mLinkId = linkId;
+    // A plant group lays its flowers or bushes out itself (on the ground around it, at init): its
+    // members are drawn from their own live matrices, as the group's children.
+    const char* pName = nullptr;
+    MR::getObjectName(&pName, rIter);
+    if (pName != nullptr && (MR::isEqualString(pName, "FlowerGroup") || MR::isEqualString(pName, "FlowerBlueGroup") ||
+                             MR::isEqualString(pName, "CutBushGroup"))) {
+        PlantGroup* pGroup = static_cast< PlantGroup* >(pActor);
+        for (s32 i = 0; i < pGroup->mMemberCount && sCount < THOR_WORLD_PIECES; i++) {
+            if (pGroup->mMembers == nullptr || pGroup->mMembers[i] == nullptr) {
+                continue;
+            }
+            Entry& rMember = sEntries[sCount++];
+            rMember.mActor = pGroup->mMembers[i];
+            rMember.mZone = static_cast< s16 >(slot);
+            rMember.mChild = static_cast< s16 >(i + 1);
+            rMember.mLinkId = linkId;
+        }
+    }
+    sChanged = true;
+}
+
+// GameSystemSceneController::destroyScene, before the scene is deleted.
+void thorWorldClear() {
+    Guard guard;
+    sCount = 0;
+    sHeader.zoneCount = 0;
+    sChanged = true;
+}
+
+// GameSystem::frameLoop, after thorLowerPublish.
+void thorWorldPublish() {
+    if (port_thor_world_commit == nullptr) {
+        return;
+    }
+    Guard guard;
+    if (sChanged) {
+        sGeneration++;
+        sChanged = false;
+    }
+    for (s32 i = 0; i < sCount; i++) {
+        const LiveActor* pActor = sEntries[i].mActor;
+        ThorWorldPiece& rPiece = sPieces[i];
+        rPiece.zone = sEntries[i].mZone;
+        rPiece.linkId = sEntries[i].mLinkId;
+        rPiece.child = sEntries[i].mChild;
+        rPiece.reserved = 0;
+        u16 flags = 0;
+        if (!pActor->mFlag.mIsDead) flags |= THOR_PIECE_ALIVE;
+        if (pActor->mFlag.mIsHiddenModel) flags |= THOR_PIECE_HIDDEN;
+        if (pActor->mFlag.mIsClipped) flags |= THOR_PIECE_CLIPPED;
+        MtxPtr pMtx = pActor->mModelManager != nullptr ? pActor->getBaseMtx() : nullptr;
+        if (pMtx != nullptr) {
+            flags |= THOR_PIECE_MATRIX;
+            memcpy(rPiece.mtx, pMtx, sizeof rPiece.mtx);
+        } else {
+            // No model matrix: position and rotation (degrees), as the placement gives them.
+            memset(rPiece.mtx, 0, sizeof rPiece.mtx);
+            rPiece.mtx[0] = pActor->mRotation.x; rPiece.mtx[1] = pActor->mRotation.y; rPiece.mtx[2] = pActor->mRotation.z;
+            rPiece.mtx[3] = pActor->mPosition.x; rPiece.mtx[7] = pActor->mPosition.y; rPiece.mtx[11] = pActor->mPosition.z;
+        }
+        rPiece.scale[0] = pActor->mScale.x; rPiece.scale[1] = pActor->mScale.y; rPiece.scale[2] = pActor->mScale.z;
+        rPiece.flags = flags;
+    }
+    sHeader.version = THOR_WORLD_VERSION;
+    sHeader.generation = sGeneration;
+    sHeader.count = static_cast< u32 >(sCount);
+    port_thor_world_commit(&sHeader, sPieces, static_cast< u32 >(sCount));
+}
+
+#endif  // TARGET_MOBILE
diff --git a/platform/include/port/thor_lower.h b/platform/include/port/thor_lower.h
new file mode 100644
index 0000000..6a3f3ac
--- /dev/null
+++ b/platform/include/port/thor_lower.h
@@ -0,0 +1,135 @@
+// AYN Thor lower screen: one read-only snapshot of Super Mario Galaxy's state.
+//
+// Sampled on the game thread after each frame's update (decomp/src/Game/System/ThorLowerState.cpp,
+// called from GameSystem::frameLoop), published under a seqlock by the platform
+// (platform/mobile/thor/ThorLowerBridge.cpp) and copied by the Java lower screen as raw bytes
+// (GalaxyActivity.nativeLowerState, little-endian, this exact layout). No game pointers leave the
+// game thread; strings are copied. Nothing here writes game state.
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    THOR_LOWER_VERSION = 2,
+    THOR_LOWER_STARS = 24,      // Power Stars per galaxy (Galaxy 1's largest has 7; bounded)
+    THOR_LOWER_GALAXIES = 48,   // open galaxies in the Observatory ledger (Galaxy 1 has 42)
+    THOR_LOWER_NAME = 48,       // UTF-16 code units, NUL-terminated
+    THOR_LOWER_SHORT = 32,
+};
+
+// What the game is doing, from the scene controller and GameScene's own steps.
+enum ThorLowerPhase {
+    THOR_PHASE_NONE = 0,           // no scene yet / unknown
+    THOR_PHASE_LOGO = 1,           // LogoScene (boot logos)
+    THOR_PHASE_FILE_SELECT = 2,    // the FileSelect stage (title and file select)
+    THOR_PHASE_LOADING = 3,        // scene change under way, or the stage still initializing
+    THOR_PHASE_MISSION_SELECT = 4, // ScenarioSelectScene choosing a mission
+    THOR_PHASE_PLAY = 5,           // GameScene action
+    THOR_PHASE_PAUSE = 6,          // GameScene pause menu
+    THOR_PHASE_STAR_GET = 7,       // Power Star / Grand Star get
+    THOR_PHASE_CUTSCENE = 8,       // opening camera, scenario starter, event demo, movie
+    THOR_PHASE_MISS = 9,           // game over, retry after a miss, save after game over, time up
+    THOR_PHASE_MAP = 10,           // the galaxy map
+    THOR_PHASE_CREDITS = 11,       // staff roll
+    THOR_PHASE_INTERMISSION = 12,  // IntermissionScene / PlayTimerScene
+};
+
+// Per-field validity (ThorLowerState.valid).
+enum {
+    THOR_VALID_STAGE = 1 << 0,     // stage, galaxyName
+    THOR_VALID_SCENARIO = 1 << 1,  // scenarioNo, selectedScenarioNo, scenarioName
+    THOR_VALID_STARS = 1 << 2,     // galaxyStars, galaxyStarsOwned, starFlags, starNames
+    THOR_VALID_COUNTERS = 1 << 3,  // totalStars, starBitsRun, starBitsBanked, coins, lives
+    THOR_VALID_LEDGER = 1 << 4,    // galaxyCount, galaxy* arrays (Observatory)
+    THOR_VALID_PURPLE = 1 << 5,    // purpleCoins (a 100-purple-coin mission)
+    THOR_VALID_MARIO = 1 << 6,     // marioPos, marioUp (the player is in the scene)
+};
+
+// ThorLowerState.flags
+enum {
+    THOR_FLAG_ASTRO = 1 << 0,          // MR::isStageAstroLocation (Observatory, dome, library)
+    THOR_FLAG_LUIGI = 1 << 1,          // MR::isPlayerLuigi
+    THOR_FLAG_INFINITE_BITS = 1 << 2,  // port setting: Star Bits read 999
+    THOR_FLAG_SCENARIO_DECIDED = 1 << 3,
+    THOR_FLAG_STORYBOOK = 1 << 4,      // the prologue's picture book is open (the lower screen stays black)
+};
+
+// starFlags[i] (scenario i + 1)
+enum {
+    THOR_STAR_OWNED = 1 << 0,     // GalaxyStatusAccessor::hasPowerStar
+    THOR_STAR_COMET = 1 << 1,     // isValidNormalComet (Prankster Comet mission)
+    THOR_STAR_HIDDEN = 1 << 2,    // isHiddenStar
+    THOR_STAR_GREEN = 1 << 3,     // MR::isPowerStarGreen
+    THOR_STAR_PURPLE = 1 << 4,    // isValidCoin100 (100 purple coins)
+    THOR_STAR_GRAND = 1 << 5,     // GameDataConst::isGrandStar
+    THOR_STAR_SELECTED = 1 << 6,  // the mission being played / chosen
+};
+
+// galaxyFlags[i]
+enum {
+    THOR_GALAXY_COMPLETED = 1 << 0,  // isCompleted
+    THOR_GALAXY_CURRENT = 1 << 1,
+};
+
+typedef struct ThorLowerState {
+    int32_t version;               // THOR_LOWER_VERSION
+    int32_t phase;                 // ThorLowerPhase
+    int32_t valid;                 // THOR_VALID_*
+    int32_t flags;                 // THOR_FLAG_*
+    int32_t generation;            // changes with the stage/scenario (and on every scene change)
+    int32_t frame;                 // game frames since boot, as sampled
+    int32_t scenarioNo;            // MR::getCurrentScenarioNo (1-based; 0 none)
+    int32_t selectedScenarioNo;    // MR::getCurrentSelectedScenarioNo
+    int32_t galaxyStars;           // GalaxyStatusAccessor::getPowerStarNum
+    int32_t galaxyStarsOwned;      // getPowerStarNumOwned
+    int32_t totalStars;            // MR::getPowerStarNum (the save's Power Stars)
+    int32_t starBitsRun;           // MR::getStarPieceNum (this run; in the Observatory the bank)
+    int32_t starBitsBanked;        // MR::getStockedStarPieceNum
+    int32_t coins;                 // MR::getCoinNum
+    int32_t purpleCoins;           // MR::getPurpleCoinNum
+    int32_t lives;                 // MR::getPlayerLeft
+    int32_t galaxyCount;           // entries in the Observatory ledger
+    int32_t starFlags[THOR_LOWER_STARS];
+    int32_t galaxyOwned[THOR_LOWER_GALAXIES];
+    int32_t galaxyTotal[THOR_LOWER_GALAXIES];
+    int32_t galaxyFlags[THOR_LOWER_GALAXIES];
+    char stage[32];                // internal stage name: diagnostics only
+    uint16_t galaxyName[THOR_LOWER_NAME];    // MR::getGalaxyNameOnCurrentLanguage
+    uint16_t scenarioName[THOR_LOWER_NAME];  // the selected mission's name
+    uint16_t starNames[THOR_LOWER_STARS][THOR_LOWER_NAME];  // only owned or selected missions
+    uint16_t galaxyNames[THOR_LOWER_GALAXIES][THOR_LOWER_SHORT];  // short names
+    float marioPos[3];             // MR::getPlayerPos, world units (version 2: the lower screen's map)
+    float marioUp[3];              // MR::getPlayerUpVec
+} ThorLowerState;
+
+// Byte offsets the Java reader uses (GalaxyLowerScreen.java); checked at compile time.
+#define THOR_LOWER_OFF_STAR_FLAGS 68
+#define THOR_LOWER_OFF_GALAXY_OWNED (THOR_LOWER_OFF_STAR_FLAGS + 4 * THOR_LOWER_STARS)
+#define THOR_LOWER_OFF_GALAXY_TOTAL (THOR_LOWER_OFF_GALAXY_OWNED + 4 * THOR_LOWER_GALAXIES)
+#define THOR_LOWER_OFF_GALAXY_FLAGS (THOR_LOWER_OFF_GALAXY_TOTAL + 4 * THOR_LOWER_GALAXIES)
+#define THOR_LOWER_OFF_STAGE (THOR_LOWER_OFF_GALAXY_FLAGS + 4 * THOR_LOWER_GALAXIES)
+#define THOR_LOWER_OFF_GALAXY_NAME (THOR_LOWER_OFF_STAGE + 32)
+#define THOR_LOWER_OFF_SCENARIO_NAME (THOR_LOWER_OFF_GALAXY_NAME + 2 * THOR_LOWER_NAME)
+#define THOR_LOWER_OFF_STAR_NAMES (THOR_LOWER_OFF_SCENARIO_NAME + 2 * THOR_LOWER_NAME)
+#define THOR_LOWER_OFF_GALAXY_NAMES (THOR_LOWER_OFF_STAR_NAMES + 2 * THOR_LOWER_STARS * THOR_LOWER_NAME)
+#define THOR_LOWER_OFF_MARIO (THOR_LOWER_OFF_GALAXY_NAMES + 2 * THOR_LOWER_GALAXIES * THOR_LOWER_SHORT)
+#define THOR_LOWER_SIZE (THOR_LOWER_OFF_MARIO + 24)
+
+// Published by the game thread (platform side; absent on non-Thor builds).
+void port_thor_lower_commit(const ThorLowerState* state);
+// Whether the lower screen is up and polling (platform/src/gx/vk/vk_thor_capture.cpp). While it is,
+// coins and Star Bits are shown there, and the upper HUD leaves them out (Sunshine's split).
+int port_thor_lower_visible(void);
+
+#ifdef __cplusplus
+}
+static_assert(sizeof(ThorLowerState) == THOR_LOWER_SIZE, "ThorLowerState layout");
+static_assert(__builtin_offsetof(ThorLowerState, starFlags) == THOR_LOWER_OFF_STAR_FLAGS, "starFlags offset");
+static_assert(__builtin_offsetof(ThorLowerState, stage) == THOR_LOWER_OFF_STAGE, "stage offset");
+static_assert(__builtin_offsetof(ThorLowerState, galaxyNames) == THOR_LOWER_OFF_GALAXY_NAMES, "galaxyNames offset");
+static_assert(__builtin_offsetof(ThorLowerState, marioPos) == THOR_LOWER_OFF_MARIO, "marioPos offset");
+#endif
diff --git a/platform/include/port/thor_world.h b/platform/include/port/thor_world.h
new file mode 100644
index 0000000..f57bdd3
--- /dev/null
+++ b/platform/include/port/thor_world.h
@@ -0,0 +1,53 @@
+#pragma once
+// AYN Thor lower screen: the live state of the stage's placed world pieces (planets, map parts,
+// scenery), so the lower screen's 3D diorama shows what the game shows: a piece that a cutscene
+// or switch makes appear appears there too, moving and rotating parts move, broken parts go.
+//
+// Written by the game thread once a frame (decomp/src/Game/System/ThorWorldState.cpp) and read by
+// the helper app through GalaxyActivity.nativeWorldState (platform/mobile/thor/ThorLowerBridge.cpp).
+// Pieces are keyed as the placement files key them: the zone's name and the object's l_id, which
+// is what Bake-LowerPlanets.py records for each baked piece; the members a group object lays out
+// itself (a flower group's flowers) follow it with child 1, 2, ... Little-endian, packed as declared.
+#include <stdint.h>
+
+#define THOR_WORLD_VERSION 1
+#define THOR_WORLD_PIECES 4096
+#define THOR_WORLD_ZONES 64
+#define THOR_WORLD_ZONE_NAME 48
+
+enum {
+    THOR_PIECE_ALIVE = 1,    // the actor exists in the scene now (not dead)
+    THOR_PIECE_HIDDEN = 2,   // alive, but its model is hidden
+    THOR_PIECE_MATRIX = 4,   // mtx holds its model's base matrix (else its position and rotation)
+    THOR_PIECE_CLIPPED = 8,  // outside the upper camera's view (still drawn on the lower screen)
+};
+
+typedef struct ThorWorldPiece {
+    int16_t zone;        // index into ThorWorldHeader.zones
+    uint16_t flags;      // THOR_PIECE_*
+    int32_t linkId;      // the placement's l_id
+    int16_t child;       // 0: the placed object itself; k: its k-th member
+    int16_t reserved;
+    float mtx[12];       // world matrix, row-major 3x4, without scale
+    float scale[3];
+} ThorWorldPiece;        // 72 bytes
+
+typedef struct ThorWorldHeader {
+    uint32_t version;
+    uint32_t generation;  // changes whenever the set of pieces does (a new scene)
+    uint32_t count;       // pieces that follow the header
+    uint32_t zoneCount;
+    char zones[THOR_WORLD_ZONES][THOR_WORLD_ZONE_NAME];
+} ThorWorldHeader;        // 16 + 3072 bytes
+
+#define THOR_WORLD_SIZE (sizeof(ThorWorldHeader) + THOR_WORLD_PIECES * sizeof(ThorWorldPiece))
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+// Copies the latest published world state into [out] (at most [size] bytes); returns its
+// sequence number (0 when there is none yet) and leaves [out] untouched when it is unchanged.
+uint32_t port_thor_world_copy(uint8_t* out, int size, uint32_t have);
+#ifdef __cplusplus
+}
+#endif
diff --git a/platform/mobile/thor/ThorLowerBridge.cpp b/platform/mobile/thor/ThorLowerBridge.cpp
new file mode 100644
index 0000000..a3c9991
--- /dev/null
+++ b/platform/mobile/thor/ThorLowerBridge.cpp
@@ -0,0 +1,163 @@
+// AYN Thor lower screen: the platform half of the Galaxy state bridge.
+//
+// The game thread commits one ThorLowerState per frame (decomp/src/Game/System/ThorLowerState.cpp)
+// into a seqlocked static buffer; the Java lower screen copies it out through
+// GalaxyActivity.nativeLowerState, registered here with RegisterNatives because libgame.so is
+// loaded RTLD_LOCAL into its reserved window (platform/android/launcher.c), where the VM's own
+// JNI symbol lookup cannot see it. No heap allocation, no game pointers cross to Java.
+#include "ThorLowerBridge.h"
+
+#include <android/log.h>
+#include <string.h>
+
+#include "port/thor_lower.h"
+#include "port/thor_world.h"
+
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, "GalaxyThorLower", __VA_ARGS__)
+#define LOGW(...) __android_log_print(ANDROID_LOG_WARN, "GalaxyThorLower", __VA_ARGS__)
+
+// The live space picture and the upper screen's bright level (platform/src/gx/vk/vk_thor_capture.cpp).
+extern "C" uint32_t port_thor_space_copy(uint8_t* out, int size, uint32_t have, int* mode);
+extern "C" int port_thor_top_level(void);
+
+namespace {
+    ThorLowerState sPublished;
+
+    // 620x540 RGBA, rows top first; returns its sequence (0 when nothing newer than `have`),
+    // with its kind in mode[0] (1, the title: the only picture taken). mode[1], every call: the
+    // upper screen's bright level (0..255, -1 before the first measurement).
+    jint JNICALL nativeSpace(JNIEnv* env, jclass, jobject buffer, jint have, jintArray mode) {
+        if (buffer == nullptr) return 0;
+        void* out = env->GetDirectBufferAddress(buffer);
+        if (out == nullptr) return 0;
+        int captured = 0;
+        const uint32_t seq = port_thor_space_copy(static_cast<uint8_t*>(out), (int)env->GetDirectBufferCapacity(buffer),
+                                                  static_cast<uint32_t>(have), &captured);
+        if (seq != 0 && mode != nullptr && env->GetArrayLength(mode) >= 1) {
+            jint m = captured;
+            env->SetIntArrayRegion(mode, 0, 1, &m);
+        }
+        if (mode != nullptr && env->GetArrayLength(mode) >= 2) {
+            jint level = port_thor_top_level();
+            env->SetIntArrayRegion(mode, 1, 1, &level);
+        }
+        return static_cast<jint>(seq);
+    }
+    uint32_t sSeq;  // odd while the game thread writes
+
+    jint JNICALL nativeLowerState(JNIEnv* env, jclass, jobject buffer) {
+        if (buffer == nullptr) return 0;
+        void* out = env->GetDirectBufferAddress(buffer);
+        if (out == nullptr || env->GetDirectBufferCapacity(buffer) < (jlong)sizeof(ThorLowerState)) return 0;
+        for (int tries = 0; tries < 8; tries++) {
+            const uint32_t before = __atomic_load_n(&sSeq, __ATOMIC_ACQUIRE);
+            if (before == 0 || (before & 1)) continue;
+            memcpy(out, &sPublished, sizeof(ThorLowerState));
+            __atomic_thread_fence(__ATOMIC_ACQUIRE);
+            if (__atomic_load_n(&sSeq, __ATOMIC_ACQUIRE) == before) return (jint)(before >> 1);
+        }
+        return 0;
+    }
+}  // namespace
+
+// The stage's live world pieces (decomp/src/Game/System/ThorWorldState.cpp), seqlocked as above.
+namespace {
+    alignas(8) uint8_t sWorld[THOR_WORLD_SIZE];
+    uint32_t sWorldBytes;
+    uint32_t sWorldSeq;  // odd while the game thread writes
+}  // namespace
+
+extern "C" void port_thor_world_commit(const ThorWorldHeader* header, const ThorWorldPiece* pieces, uint32_t count) {
+    if (header == nullptr) return;
+    if (count > THOR_WORLD_PIECES) count = THOR_WORLD_PIECES;
+    const uint32_t seq = __atomic_load_n(&sWorldSeq, __ATOMIC_RELAXED);
+    __atomic_store_n(&sWorldSeq, seq + 1, __ATOMIC_RELEASE);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    memcpy(sWorld, header, sizeof(ThorWorldHeader));
+    reinterpret_cast<ThorWorldHeader*>(sWorld)->count = count;
+    if (count > 0) memcpy(sWorld + sizeof(ThorWorldHeader), pieces, count * sizeof(ThorWorldPiece));
+    sWorldBytes = static_cast<uint32_t>(sizeof(ThorWorldHeader) + count * sizeof(ThorWorldPiece));
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    __atomic_store_n(&sWorldSeq, seq + 2, __ATOMIC_RELEASE);
+}
+
+extern "C" uint32_t port_thor_world_copy(uint8_t* out, int size, uint32_t have) {
+    if (out == nullptr || size < (int)sizeof(ThorWorldHeader)) return 0;
+    for (int tries = 0; tries < 8; tries++) {
+        const uint32_t before = __atomic_load_n(&sWorldSeq, __ATOMIC_ACQUIRE);
+        if (before == 0) return 0;
+        if (before & 1) continue;
+        if ((before >> 1) == have) return 0;  // nothing newer
+        uint32_t bytes = sWorldBytes;
+        if (bytes > (uint32_t)size)
+            bytes = (uint32_t)(sizeof(ThorWorldHeader) + (size - sizeof(ThorWorldHeader)) / sizeof(ThorWorldPiece) * sizeof(ThorWorldPiece));
+        memcpy(out, sWorld, bytes);
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if (__atomic_load_n(&sWorldSeq, __ATOMIC_ACQUIRE) == before) {
+            ThorWorldHeader* h = reinterpret_cast<ThorWorldHeader*>(out);
+            const uint32_t fits = (bytes - sizeof(ThorWorldHeader)) / sizeof(ThorWorldPiece);
+            if (h->count > fits) h->count = fits;
+            return before >> 1;
+        }
+    }
+    return 0;
+}
+
+namespace {
+    // The world state into a direct buffer; its sequence, or 0 when nothing is newer than `have`.
+    jint JNICALL nativeWorldState(JNIEnv* env, jclass, jobject buffer, jint have) {
+        if (buffer == nullptr) return 0;
+        void* out = env->GetDirectBufferAddress(buffer);
+        if (out == nullptr) return 0;
+        return static_cast<jint>(port_thor_world_copy(static_cast<uint8_t*>(out), (int)env->GetDirectBufferCapacity(buffer),
+                                                      static_cast<uint32_t>(have)));
+    }
+}  // namespace
+
+extern "C" void port_thor_lower_commit(const ThorLowerState* state) {
+    if (state == nullptr) return;
+    const uint32_t seq = __atomic_load_n(&sSeq, __ATOMIC_RELAXED);
+    __atomic_store_n(&sSeq, seq + 1, __ATOMIC_RELEASE);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    memcpy(&sPublished, state, sizeof(ThorLowerState));
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    __atomic_store_n(&sSeq, seq + 2, __ATOMIC_RELEASE);
+}
+
+namespace mobile_thor {
+
+void registerLowerBridge(ANativeActivity* activity) {
+    if (activity == nullptr || activity->vm == nullptr || activity->clazz == nullptr) return;
+    JNIEnv* env = nullptr;
+    bool attached = false;
+    jint got = activity->vm->GetEnv((void**)&env, JNI_VERSION_1_6);
+    if (got == JNI_EDETACHED) {
+        if (activity->vm->AttachCurrentThread(&env, nullptr) != JNI_OK || env == nullptr) return;
+        attached = true;
+    } else if (got != JNI_OK || env == nullptr) {
+        return;
+    }
+    jclass clazz = env->GetObjectClass(activity->clazz);
+    if (clazz != nullptr) {
+        static const JNINativeMethod methods[] = {
+            {"nativeLowerState", "(Ljava/nio/ByteBuffer;)I", (void*)nativeLowerState},
+            {"nativeSpace", "(Ljava/nio/ByteBuffer;I[I)I", (void*)nativeSpace},
+            {"nativeWorldState", "(Ljava/nio/ByteBuffer;I)I", (void*)nativeWorldState},
+        };
+        // One at a time: an older helper without a declaration loses only that method.
+        for (const JNINativeMethod& method : methods) {
+            if (env->RegisterNatives(clazz, &method, 1) == JNI_OK) {
+                LOGI("lower screen bridge: %s registered (state %zu bytes, version %d)", method.name, sizeof(ThorLowerState),
+                     THOR_LOWER_VERSION);
+            } else {
+                if (env->ExceptionCheck()) env->ExceptionClear();
+                LOGW("lower screen bridge: %s not registered", method.name);
+            }
+        }
+        env->DeleteLocalRef(clazz);
+    }
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    if (attached) activity->vm->DetachCurrentThread();
+}
+
+}  // namespace mobile_thor
diff --git a/platform/mobile/thor/ThorLowerBridge.h b/platform/mobile/thor/ThorLowerBridge.h
new file mode 100644
index 0000000..9b554dd
