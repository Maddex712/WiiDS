@@ -903,6 +903,51 @@ namespace MR {
     }
 #endif
 
+#ifdef TARGET_MOBILE
+    // The modes in which the player picks from a menu with the finger cursor; Mario cannot move in
+    // any of them. Title, Logo, HOME and the error windows hide the pointer; every other mode is
+    // play or a cutscene.
+    static bool isMenuPointerModeForPort(s32 mode) {
+        switch (mode) {
+        case StarPointerMode_FileSelect:                 // file select, Mii select, Mario/Luigi, manual
+        case StarPointerMode_ScenarioSelectScene:        // star select
+        case StarPointerMode_PauseMenu:                  // pause, star list, galaxy map, comet retry, game-over save
+        case StarPointerMode_ChooseYesNo:                // yes/no in a talk
+        case StarPointerMode_PictureBook:                // storybook, while its close button shows
+        case StarPointerMode_DemoWithHandPointerFinger:  // the save after a story event or the staff roll
+        case StarPointerMode_SphereSelectorOnReaction:   // the observatory dome's galaxy selector
+        case StarPointerMode_SphereSelectorFinger:
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    // Whether the pointer is choosing from a menu rather than aiming in play, for a gamepad's left
+    // stick (platform/mobile/input/GamepadInput.cpp). Called once a frame on the game thread. False
+    // until the sequence that owns the pointer modes exists.
+    bool isStarPointerModeMenuForPort() {
+        GameSystem* pSystem = SingletonHolder< GameSystem >::get();
+        if (pSystem == nullptr || pSystem->mSequenceDirector == nullptr || pSystem->mSequenceDirector->mGameSequenceProgress == nullptr ||
+            pSystem->mSequenceDirector->mGameSequenceProgress->mStarPointerOnOffController == nullptr) {
+            return false;
+        }
