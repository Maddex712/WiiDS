+
 void GamepadInput::reset() {
+    for (bool& held : mHeld) held = false;
+    mActionButtons = 0;
     mPhysicalButtons = 0;
     mPhysicalAxisButtons = 0;
+    mPhysicalStickX = mPhysicalStickY = 0.0f;
+    mPointerStickX = mPointerStickY = 0.0f;
+    mMenuStickX = mMenuStickY = 0.0f;
+    mStickLatched = false;
