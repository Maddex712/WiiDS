     u32* cmd = appendCmds(2);
     cmd[0] = CMD_BP;
     cmd[1] = (reg << 24) | (value & 0xFFFFFF);
+    if (reg == 0x66) {
+        // An explicit GX texture-cache invalidation can follow a RAM rewrite
